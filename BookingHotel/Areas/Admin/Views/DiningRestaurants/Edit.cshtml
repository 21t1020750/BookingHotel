@model BookingHotel.Areas.Admin.Models.Restaurant

@{
    ViewData["Title"] = "Sửa Nhà Hàng & Quán Bar";
    var tags = ViewBag.Tags as List<BookingHotel.Areas.Admin.Models.Tag>;
    var selectedTagIds = ViewBag.SelectedTagIds as List<int>;
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0">Sửa Thông Tin</h1>
                </div>
                <div class="col-sm-6">
                    <a asp-action="Index" class="btn btn-secondary float-right">Quay Lại</a>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-6">
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">Thông Tin Nhà Hàng</h3>
                        </div>
                        <form asp-action="Edit">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <input type="hidden" asp-for="RestaurantID" />
                            <input type="hidden" asp-for="CreatedAt" />
                            <div class="card-body">
                                <div class="form-group">
                                    <label asp-for="Name" class="control-label"></label>
                                    <input asp-for="Name" class="form-control" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Description" class="control-label"></label>
                                    <textarea asp-for="Description" class="form-control"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="OperatingHours" class="control-label"></label>
                                    <input asp-for="OperatingHours" class="form-control" />
                                    <span asp-validation-for="OperatingHours" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="ImageURL" class="control-label"></label>
                                    <input asp-for="ImageURL" class="form-control" placeholder="Nhập tên file (ví dụ: download1.jpg)" />
                                    <span asp-validation-for="ImageURL" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label for="selectedTagIds" class="control-label">Tags</label>
                                    <select multiple name="selectedTagIds" class="form-control">
                                        @foreach (var tag in tags)
                                        {
                                            <option value="@tag.TagID" selected="@(selectedTagIds.Contains(tag.TagID) ? "selected" : null)">@tag.TagName</option>
                                        }
                                    </select>
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            <div class="card-footer">
                                <button type="submit" class="btn btn-primary">Lưu</button>
                                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}