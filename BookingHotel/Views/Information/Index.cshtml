    <script data-id="1ncvdhrg" data-line="506-598">
        document.addEventListener('DOMContentLoaded', function() {
            // Profile edit functionality
            const editProfileBtn = document.getElementById('editProfileBtn');
            const cancelEditBtn = document.getElementById('cancelEditBtn');
            const profileForm = document.getElementById('profileForm');
            const saveBtnContainer = document.getElementById('saveBtnContainer');
            const inputs = profileForm.querySelectorAll('input, textarea');
            const uploadPhotoInput = document.getElementById('uploadPhotoInput');
            const photoPreview = document.getElementById('photoPreview');
            const editPhotoIcon = document.getElementById('editPhotoIcon');
            const photoMenu = document.getElementById('photoMenu');
            const changePhotoOption = document.getElementById('changePhotoOption');
            const viewPhotoOption = document.getElementById('viewPhotoOption');
            const photoModal = document.getElementById('photoModal');
            const modalImage = document.getElementById('modalImage');
            const modalClose = document.getElementById('modalClose');

            if (editProfileBtn) {
                editProfileBtn.addEventListener('click', function() {
                    inputs.forEach(input => {
                        input.classList.remove('readonly-input');
                        input.readOnly = false;
                    });
                    editPhotoIcon.classList.remove('hidden');
                    saveBtnContainer.classList.remove('hidden');
                    editProfileBtn.classList.add('hidden');
                });
            }

            if (cancelEditBtn) {
                cancelEditBtn.addEventListener('click', function() {
                    inputs.forEach(input => {
                        input.classList.add('readonly-input');
                        input.readOnly = true;
                    });
                    editPhotoIcon.classList.add('hidden');
                    photoMenu.classList.remove('show');
                    uploadPhotoInput.value = ''; // Reset file input
                    photoPreview.src = '/images/Customer/@(Model.Customer.Photo ?? "nophoto.png")'; // Reset preview
                    saveBtnContainer.classList.add('hidden');
                    if (editProfileBtn) editProfileBtn.classList.remove('hidden');
                });
            }

            if (editPhotoIcon) {
                editPhotoIcon.addEventListener('click', function(e) {
                    e.stopPropagation(); // Prevent triggering photoPreview click
                    uploadPhotoInput.click(); // Trigger file input click
                });
            }

            if (photoPreview) {
                photoPreview.addEventListener('click', function(e) {
                    e.stopPropagation();
                    if (editPhotoIcon.classList.contains('hidden')) return; // Only show menu when in edit mode
                    photoMenu.classList.toggle('show');
                });
            }

            if (changePhotoOption) {
                changePhotoOption.addEventListener('click', function() {
                    uploadPhotoInput.click();
                    photoMenu.classList.remove('show');
                });
            }

            if (viewPhotoOption) {
                viewPhotoOption.addEventListener('click', function() {
                    modalImage.src = photoPreview.src;
                    photoModal.classList.add('show');
                    photoMenu.classList.remove('show');
                });
            }

            if (modalClose) {
                modalClose.addEventListener('click', function() {
                    photoModal.classList.remove('show');
                });
            }

            if (photoModal) {
                photoModal.addEventListener('click', function(e) {
                    if (e.target === photoModal) {
                        photoModal.classList.remove('show');
                    }
                });
            }

            if (uploadPhotoInput) {
                uploadPhotoInput.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            photoPreview.src = e.target.result;
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }

            if (profileForm) {
                profileForm.addEventListener('submit', function(e) {
                    // Form will be submitted to the server via POST
                });
            }

            // Close photo menu when clicking outside
            document.addEventListener('click', function(e) {
                if (!photoMenu.contains(e.target) && !photoPreview.contains(e.target)) {
                    photoMenu.classList.remove('show');
                }
            });

            // Tab navigation functionality
            const tabs = document.querySelectorAll('.nav-tab');
            const sections = ['profile', 'bookings', 'history', 'reviews', 'security', 'rewards'];

            function activateTab(targetId) {
                tabs.forEach(t => t.classList.remove('active'));
                const activeTab = Array.from(tabs).find(tab => tab.getAttribute('href').substring(1) === targetId);
                if (activeTab) {
                    activeTab.classList.add('active');
                }

                sections.forEach(section => {
                    const element = document.getElementById(section);
                    if (element) {
                        if (section === targetId) {
                            element.classList.remove('hidden');
                        } else {
                            element.classList.add('hidden');
                        }
                    }
                });
            }

            tabs.forEach(tab => {
                tab.addEventListener('click', function(e) {
                    e.preventDefault();
                    const targetId = this.getAttribute('href').substring(1);
                    window.location.hash = targetId;
                    activateTab(targetId);
                });
            });

            // Check URL hash on page load
            const hash = window.location.hash.substring(1);
            if (hash && sections.includes(hash)) {
                activateTab(hash);
            } else {
                // Default to first tab if no valid hash
                if (tabs.length > 0) {
                    tabs[0].click();
                }
            }
        });
    </script>
