@model IEnumerable<BookingHotel.Areas.Admin.Models.RestaurantViewModel>

@{
    ViewData["Title"] = "Danh Sách Nhà Hàng & Quán Bar";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0">Nhà Hàng & Quán Bar</h1>
                </div>
                <div class="col-sm-6">
                    <a asp-action="Create" class="btn btn-primary float-right">Thêm Nhà Hàng</a>
                    <a asp-controller="Tags" asp-action="Index" class="btn btn-info float-right mr-2">Quản Lý Tags</a>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>Tên</th>
                                        <th>Mô Tả</th>
                                        <th>Thời Gian Hoạt Động</th>
                                        <th>Tags</th>
                                        <th>Hình Ảnh</th>
                                        <th>Thao Tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.Restaurant.Name</td>
                                            <td>@item.Restaurant.Description</td>
                                            <td>@item.Restaurant.OperatingHours</td>
                                            <td>@string.Join(", ", item.Tags)</td>
                                            <td><img src="/images/Cuisine/@item.Restaurant.ImageURL" alt="@item.Restaurant.Name" style="width: 100px;" /></td>
                                            <td>
                                                <a asp-action="Edit" asp-route-id="@item.Restaurant.RestaurantID" class="btn btn-warning btn-sm">Sửa</a>
                                                <a asp-action="Delete" asp-route-id="@item.Restaurant.RestaurantID" class="btn btn-danger btn-sm">Xóa</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>