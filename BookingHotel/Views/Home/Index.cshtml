    <script>
        document.addEventListener('DOMContentLoaded', () => {
            let adults = 1;
            let children = 0;
            let rooms = 1;

            // Smooth scroll for anchor links
            document.querySelectorAll('a[href*="#"]').forEach(anchor => {
                anchor.addEventListener('click', (e) => {
                    e.preventDefault();
                    const target = document.querySelector(anchor.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({ behavior: 'smooth' });
                    }
                });
            });

            // Guests dropdown toggle
            const guestsBtn = document.getElementById('guestsBtn');
            const guestsDropdown = document.getElementById('guestsDropdown');
            guestsBtn.addEventListener('click', () => {
                guestsDropdown.classList.toggle('hidden');
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', (e) => {
                if (!guestsBtn.contains(e.target) && !guestsDropdown.contains(e.target)) {
                    guestsDropdown.classList.add('hidden');
                }
            });
        });

        let adults = 1, children = 0, rooms = 1;

        function updateGuests(type, change) {
            const adultsInput = document.getElementById('adultsCount');
            const childrenInput = document.getElementById('childrenCount');
            const roomsInput = document.getElementById('roomsCount');
            const summary = document.getElementById('guestsSummary');

            // If change is 0, get value from input (manual entry)
            if (change === 0) {
                if (type === 'adults') {
                    adults = parseInt(adultsInput.value) || 1;
                } else if (type === 'children') {
                    children = parseInt(childrenInput.value) || 0;
                } else if (type === 'rooms') {
                    rooms = parseInt(roomsInput.value) || 1;
                }
            } else {
                // Handle button clicks (+/-)
                if (type === 'adults') {
                    adults = Math.max(1, adults + change);
                    adultsInput.value = adults;
                } else if (type === 'children') {
                    children = Math.max(0, children + change);
                    childrenInput.value = children;
                } else if (type === 'rooms') {
                    rooms = Math.max(1, rooms + change);
                    roomsInput.value = rooms;
                }
            }

            // Enforce constraints
            adults = Math.max(1, adults); // Minimum 1 adult
            children = Math.max(0, children); // Minimum 0 children
            rooms = Math.max(1, rooms); // Minimum 1 room

            // Update input values
            adultsInput.value = adults;
            childrenInput.value = children;
            roomsInput.value = rooms;

            // Update summary
            summary.textContent = `${adults} Người lớn | ${children} Trẻ em | ${rooms} Phòng`;
        }

        function closeGuestsDropdown() {
            document.getElementById('guestsDropdown').classList.add('hidden');
        }
    </script>
