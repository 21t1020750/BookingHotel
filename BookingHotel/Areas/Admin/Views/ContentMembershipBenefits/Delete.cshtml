@model BookingHotel.Models.Content_MembershipBenefit

<h2>Xóa Lợi Ích Hội Viên</h2>

<h3>Bạn có chắc muốn xóa?</h3>
<div>
    <h4>@Model.Benefit</h4>
    <dl class="row">
        <dt class="col-sm-2">Lợi Ích</dt>
        <dd class="col-sm-10">@Model.Benefit</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Quay Lại</a>
    </form>
</div>