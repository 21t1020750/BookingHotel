@model BookingHotel.Controllers.OfferViewModel
@{
    ViewData["Title"] = "Trang Ưu Đãi";
}
<body class="bg-gray-100" alt="khách sạn sang trọng">
    <main class="py-12">
        <div class="mx-auto max-w-full w-[1200px] px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h1 class="text-4xl font-bold text-gray-800 mb-4">Ưu Đãi Đặc Biệt</h1>
                <p class="text-gray-600 max-w-2xl mx-auto">Khám phá các chương trình khuyến mãi và gói ưu đãi độc quyền được thiết kế để làm cho kỳ nghỉ của bạn thêm đáng nhớ</p>
            </div>

            <div class="offer-tabs">
                <div class="offer-tab active" data-tab="all">Tất Cả Ưu Đãi</div>
                @foreach (var category in Model.Categories.Where(c => c.CategoryCode != "all"))
                {
                    <div class="offer-tab" data-tab="@category.CategoryCode">@category.CategoryName</div>
                }
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var offer in Model.Offers)
                {
                    <div class="bg-white rounded-xl shadow-lg overflow-hidden offer-card" data-category="@offer.Category.CategoryCode" alt="@offer.AltText">
                        <div class="h-48 bg-blue-100 flex items-center justify-center" alt="@offer.AltText">
                            <i class="@offer.IconClass text-6xl" style="color: @(offer.Category.CategoryCode == "stay" ? "#3b82f6" : offer.Category.CategoryCode == "dining" ? "#f97316" : "#8b5cf6")"></i>
                        </div>
                        <div class="p-6">
                            <div class="flex justify-between items-start mb-4">
                                <h3 class="text-xl font-bold text-gray-800">@offer.Title</h3>
                                <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">=@offer.DiscountPercentage%</span>
                            </div>
                            <p class="text-gray-600 mb-4">@offer.Description</p>
                            <div class="offer-highlight">
                                <ul class="text-gray-600 space-y-2">
                                    @foreach (var highlight in offer.Highlights)
                                    {
                                        <li class="flex items-start">
                                            <i class="@highlight.IconClass text-green-500 mr-2 mt-1"></i>
                                            @highlight.HighlightText
                                        </li>
                                    }
                                </ul>
                            </div>
                            <div class="mb-4">
                                <span class="text-gray-500 line-through mr-2">@offer.OriginalPrice.ToString("C0")</span>
                                <span class="text-2xl font-bold text-blue-600">@offer.DiscountedPrice.ToString("C0")</span>
                                <span class="text-gray-500 ml-2">@offer.PriceUnit</span>
                            </div>
                            <!-- Updated Đặt Ngay button to redirect to Find_Room with offerId -->
                            <a href="/Find_Room?offerId=@offer.OfferId&checkin=@DateTime.Today.ToString("yyyy-MM-dd")&checkout=@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                               class="w-full bg-blue-600 text-white py-3 rounded-lg hover:bg-blue-700 transition font-medium text-center" alt="đặt ngay">
                                Đặt Ngay
                            </a>
                            <div class="mt-3 text-sm text-gray-500">
                                <i class="fas fa-calendar-alt mr-1"></i> Hiệu lực đến: @offer.ValidUntil.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const tabs = document.querySelectorAll('.offer-tab');
            const offerCards = document.querySelectorAll('.offer-card');

            tabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    tabs.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');

                    const category = this.getAttribute('data-tab');
                    offerCards.forEach(card => {
                        if (category === 'all' || card.getAttribute('data-category') === category) {
                            card.style.display = 'block';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });
            });
        });
    </script>
</body>