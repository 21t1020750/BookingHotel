@model IEnumerable<BookingHotel.Models.Content_Service>

<h2>Dịch Vụ Nổi Bật</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Tạo Mới</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Tên Dịch Vụ</th>
            <th>Mô Tả</th>
            <th>Icon</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@item.Icon</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>