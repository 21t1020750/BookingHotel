<aside class="main-sidebar" style="background-color:#003087">
    <!-- sidebar: style can be found in sidebar.less -->
    <section class="sidebar">
        <!-- sidebar menu: : style can be found in sidebar.less -->
        <ul class="sidebar-menu" data-widget="tree">
            <!-- Dashboard -->
            <li>
                <a href="/Admin/AdminDashboard">
                    <i class="fas fa-tachometer-alt" style="color: #FF6200;"></i> <span>Dashboard</span>
                </a>
            </li>

            <!-- Dữ liệu (Data) -->
            <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Employees" ? "active" : "")">
                <a href="/Admin/Employees">
                    <i class="fa-solid fa-user-tie" style="color: #FF6200 !important;"></i> <span>Nhân Viên</span>
                </a>
            </li>

            <li class="treeview @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Rooms" || ViewContext.RouteData.Values["Controller"]?.ToString() == "RoomTypes" ? "active" : "")">
                <a href="#">
                    <i class="fa-solid fa-bed" style="color: #FF6200 !important;"></i> <span>Phòng</span>
                </a>
                <ul class="treeview-menu" style="background-color:#003087">
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Rooms" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                        <a href="/Admin/Rooms">Danh Sách Phòng</a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "RoomTypes" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                        <a href="/Admin/RoomTypes">Thể Loại Phòng</a>
                    </li>
                </ul>
            </li>

            <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customers" ? "active" : "")">
                <a href="/Admin/Customers">
                    <i class="fa-solid fa-circle-user" style="color: #FF6200 !important;"></i> <span>Khách Hàng</span>
                </a>
            </li>

            <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Services" ? "active" : "")">
                <a href="/Admin/Services">
                    <i class="fa-solid fa-bell-concierge" style="color: #FF6200 !important;"></i> <span>Dịch Vụ</span>
                </a>
            </li>

            <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reviews" ? "active" : "")">
                <a href="/Admin/Reviews">
                    <i class="fa-solid fa-comments" style="color: #FF6200 !important;"></i> <span>Đánh Giá</span>
                </a>
            </li>

            <!-- Quản lý Booking -->
            <li class="treeview @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Bookings" ? "active" : "")">
                <a href="#">
                    <i class="fa-solid fa-receipt" style="color: #FF6200 !important;"></i> <span>Booking</span>
                </a>
                <ul class="treeview-menu">
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Bookings" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                        <a href="/Admin/Bookings">Danh Mục Booking</a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Bookings" && ViewContext.RouteData.Values["Action"]?.ToString() == "Create" ? "active" : "")">
                        <a href="/Admin/Bookings/Create">Lập Booking</a>
                    </li>
                </ul>
            </li>

            <!-- Quản Lý Nội Dung -->
            <li class="treeview @(ViewContext.RouteData.Values["Area"]?.ToString() == "Admin" && (ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentHome" || ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentBannerImages" || ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentAchivements" || ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentRooms" || ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentAmenities" || ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentOffers" || ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentMembershipBenefits" || ViewContext.RouteData.Values["Controller"]?.ToString() == "DiningHeroImages" || ViewContext.RouteData.Values["Controller"]?.ToString() == "DiningRestaurants" || ViewContext.RouteData.Values["Controller"]?.ToString() == "DiningDishes" || ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminOffers" || ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminCategories") ? "active" : "")">
                <a href="#">
                    <i class="fa-solid fa-file-alt" style="color: #FF6200 !important;"></i> <span>Quản Lý Nội Dung</span>
                    <span class="pull-right-container">
                        <i class="fa fa-angle-left pull-right"></i>
                    </span>
                </a>
                <ul class="treeview-menu" style="background-color:#003087">
                    <!-- Trang Chủ -->
                    <li class="treeview @(ViewContext.RouteData.Values["Area"]?.ToString() == "Admin" && (ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentHome" || ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentBannerImages" || ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentAchivements" || ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentRooms" || ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentAmenities" || ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentOffers" || ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentMembershipBenefits") ? "active" : "")">
                        <a asp-area="Admin" asp-controller="ContentHome" asp-action="Index">
                            <i class="fa-solid fa-home"></i> <span>Trang Chủ</span>
                            <span class="pull-right-container">
                                <i class="fa fa-angle-left pull-right"></i>
                            </span>
                        </a>
                        <ul class="treeview-menu" style="background-color:#003087">
                            <li class="@(ViewContext.RouteData.Values["Area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentBannerImages" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                                <a asp-area="Admin" asp-controller="ContentBannerImages" asp-action="Index">Hình Ảnh Nổi Bật</a>
                            </li>
                            <li class="@(ViewContext.RouteData.Values["Area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentAchivements" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                                <a asp-area="Admin" asp-controller="ContentAchivements" asp-action="Index">Thành Tựu Nổi Bật</a>
                            </li>
                            <li class="@(ViewContext.RouteData.Values["Area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentRooms" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                                <a asp-area="Admin" asp-controller="ContentRooms" asp-action="Index">Phòng Hiển Thị</a>
                            </li>
                            <li class="@(ViewContext.RouteData.Values["Area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentAmenities" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                                <a asp-area="Admin" asp-controller="ContentAmenities" asp-action="Index">Tiện Ích Hiển Thị</a>
                            </li>
                            <li class="@(ViewContext.RouteData.Values["Area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentOffers" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                                <a asp-area="Admin" asp-controller="ContentOffers" asp-action="Index">Ưu Đãi Hiển Thị</a>
                            </li>
                            <li class="@(ViewContext.RouteData.Values["Area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentMembershipBenefits" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                                <a asp-area="Admin" asp-controller="ContentMembershipBenefits" asp-action="Index">Lợi Ích Hội Viên</a>
                            </li>
                        </ul>
                    </li>
                    <!-- Ẩm Thực -->
                    <li class="treeview @(ViewContext.RouteData.Values["Area"]?.ToString() == "Admin" && (ViewContext.RouteData.Values["Controller"]?.ToString() == "DiningHeroImages" || ViewContext.RouteData.Values["Controller"]?.ToString() == "DiningRestaurants" || ViewContext.RouteData.Values["Controller"]?.ToString() == "DiningDishes") ? "active" : "")">
                        <a href="#">
                            <i class="fa-solid fa-utensils" style="color: #FF6200 !important;"></i> <span>Ẩm Thực</span>
                            <span class="pull-right-container">
                                <i class="fa fa-angle-left pull-right"></i>
                            </span>
                        </a>
                        <ul class="treeview-menu" style="background-color:#003087">
                            <li class="@(ViewContext.RouteData.Values["Area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Controller"]?.ToString() == "DiningHeroImages" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                                <a asp-area="Admin" asp-controller="DiningHeroImages" asp-action="Index">Hình Ảnh Hero</a>
                            </li>
                            <li class="@(ViewContext.RouteData.Values["Area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Controller"]?.ToString() == "DiningRestaurants" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                                <a asp-area="Admin" asp-controller="DiningRestaurants" asp-action="Index">Nhà Hàng & Quán Bar</a>
                            </li>
                            <li class="@(ViewContext.RouteData.Values["Area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Controller"]?.ToString() == "DiningDishes" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                                <a asp-area="Admin" asp-controller="DiningDishes" asp-action="Index">Món Ăn Đặc Trưng</a>
                            </li>
                        </ul>
                    </li>
                    <!-- Ưu Đãi -->
                    <li class="treeview @(ViewContext.RouteData.Values["Area"]?.ToString() == "Admin" && (ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminOffers" || ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminCategories") ? "active" : "")">
                        <a href="#">
                            <i class="fa-solid fa-spa" style="color: #FF6200 !important;"></i> <span>Ưu Đãi</span>
                            <span class="pull-right-container">
                                <i class="fa fa-angle-left pull-right"></i>
                            </span>
                        </a>
                        <ul class="treeview-menu" style="background-color:#003087">
                            <li class="@(ViewContext.RouteData.Values["Area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminOffers" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                                <a asp-area="Admin" asp-controller="AdminOffers" asp-action="Index">Quản Lý Ưu Đãi</a>
                            </li>
                            <li class="@(ViewContext.RouteData.Values["Area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminCategories" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                                <a asp-area="Admin" asp-controller="AdminCategories" asp-action="Index">Danh Mục Ưu Đãi</a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </li>
        </ul>
    </section>
    <!-- /.sidebar -->
</aside>

<style>
    .sidebar-menu li a:hover,
    .sidebar-menu li.active > a,
    .treeview-menu li.active > a {
        background-color: #ffffff !important;
        color: #003087 !important;
    }

        /* Cả icon cũng đổi màu khi active hoặc hover */
        .sidebar-menu li a:hover i,
        .sidebar-menu li.active > a i,
        .treeview-menu li.active > a i {
            color: #ffffff !important;
        }

    /* Đảm bảo hiển thị submenu khi menu cha có class menu-open */
    .treeview-menu {
        background-color: #003087 !important;
    }

        /* Highlight khi đang trong submenu */
        .treeview-menu > li > a:hover {
            background-color: #ffffff !important;
            color: #003087 !important;
        }
</style>