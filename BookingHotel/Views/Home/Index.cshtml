                        }
                        else
                        {
                            <p>Không có lợi ích hội viên để hiển thị.</p>
                        }
                        <a href="#" class="px-8 py-3 bg-blue-600 text-white font-medium rounded hover:bg-blue-700 transition duration-300 inline-block" alt="tham gia ngay">Tham Gia Ngay</a>
                    </div>
                    <div class="relative">
                        <img src="https://images.unsplash.com/photo-1551632436-cbf8dd35adfa?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1471&q=80"
                             alt="lợi ích hội viên"
                             class="rounded-lg shadow-xl w-full h-full object-cover aspect-[4/3]"
                             loading="lazy">
                    </div>
                </div>
            </div>
        </section>
    </main>

    <style>
        
        main, .mx-auto, body {
            overflow: visible !important;
        }
        /* Hide number input arrows */
        input.no-spinner[type="number"] {
            -webkit-appearance: none;
            -moz-appearance: textfield;
            appearance: none;
        }

            input.no-spinner[type="number"]::-webkit-outer-spin-button,
            input.no-spinner[type="number"]::-webkit-inner-spin-button {
                -webkit-appearance: none;
                margin: 0;
            }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            let adults = 1;
            let children = 0;
            let rooms = 1;

            // Smooth scroll for anchor links
            document.querySelectorAll('a[href*="#"]').forEach(anchor => {
                anchor.addEventListener('click', (e) => {
                    e.preventDefault();
                    const target = document.querySelector(anchor.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({ behavior: 'smooth' });
                    }
                });
            });

            // Guests dropdown toggle
            const guestsBtn = document.getElementById('guestsBtn');
            const guestsDropdown = document.getElementById('guestsDropdown');
            guestsBtn.addEventListener('click', () => {
                guestsDropdown.classList.toggle('hidden');
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', (e) => {
                if (!guestsBtn.contains(e.target) && !guestsDropdown.contains(e.target)) {
                    guestsDropdown.classList.add('hidden');
                }
            });
        });

        let adults = 1, children = 0, rooms = 1;

        function updateGuests(type, change) {
            const adultsInput = document.getElementById('adultsCount');
            const childrenInput = document.getElementById('childrenCount');
            const roomsInput = document.getElementById('roomsCount');
            const summary = document.getElementById('guestsSummary');

            // If change is 0, get value from input (manual entry)
            if (change === 0) {
                if (type === 'adults') {
                    adults = parseInt(adultsInput.value) || 1;
                } else if (type === 'children') {
                    children = parseInt(childrenInput.value) || 0;
                } else if (type === 'rooms') {
                    rooms = parseInt(roomsInput.value) || 1;
                }
            } else {
                // Handle button clicks (+/-)
                if (type === 'adults') {
                    adults = Math.max(1, adults + change);
                    adultsInput.value = adults;
                } else if (type === 'children') {
                    children = Math.max(0, children + change);
                    childrenInput.value = children;
                } else if (type === 'rooms') {
                    rooms = Math.max(1, rooms + change);
                    roomsInput.value = rooms;
                }
            }

            // Enforce constraints
            adults = Math.max(1, adults); // Minimum 1 adult
            children = Math.max(0, children); // Minimum 0 children
            rooms = Math.max(1, rooms); // Minimum 1 room

            // Update input values
            adultsInput.value = adults;
            childrenInput.value = children;
            roomsInput.value = rooms;

            // Update summary
            summary.textContent = `${adults} Người lớn | ${children} Trẻ em | ${rooms} Phòng`;
        }

        function closeGuestsDropdown() {
            document.getElementById('guestsDropdown').classList.add('hidden');
        }
    </script>
    <!-- Thêm vào phần <script> -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Các mã JavaScript khác (guests, smooth scroll, v.v.) giữ nguyên...

        // Xử lý ngày check-in và check-out
        const checkinInput = document.getElementById('checkin');
        const checkoutInput = document.getElementById('checkout');

        // Hàm lấy ngày hiện tại dưới định dạng yyyy-MM-dd
        function getToday() {
            const today = new Date();
            return today.toISOString().split('T')[0];
        }

        // Hàm cập nhật ngày tối thiểu cho check-out
        function updateCheckoutMinDate() {
            const checkinDate = checkinInput.value;
            if (checkinDate) {
                const minCheckoutDate = new Date(checkinDate);
                minCheckoutDate.setDate(minCheckoutDate.getDate() + 1);
                checkoutInput.min = minCheckoutDate.toISOString().split('T')[0];

                // Kiểm tra nếu ngày check-out hiện tại không hợp lệ
                if (checkoutInput.value && new Date(checkoutInput.value) <= new Date(checkinDate)) {
                    checkoutInput.value = minCheckoutDate.toISOString().split('T')[0];
                    alert('Ngày trả phòng phải sau ngày nhận phòng. Ngày trả phòng đã được điều chỉnh.');
                }
            } else {
                checkoutInput.min = getToday();
            }
        }

        // Kiểm tra khi chọn ngày check-out
        checkoutInput.addEventListener('change', () => {
            if (!checkinInput.value) {
                alert('Vui lòng chọn ngày nhận phòng.');
                checkoutInput.value = '';
            } else {
                updateCheckoutMinDate();
            }
        });

        // Đặt ngày tối thiểu cho check-in là hôm nay
        checkinInput.min = getToday();

        // Cập nhật ngày tối thiểu cho check-out khi check-in thay đổi
        checkinInput.addEventListener('change', updateCheckoutMinDate);

        // Khởi tạo ngày tối thiểu cho check-out khi tải trang
        updateCheckoutMinDate();

        // Cập nhật hàm submit form để kiểm tra ngày
        const form = document.getElementById('searchForm');
        form.addEventListener('submit', (e) => {
            e.preventDefault();

            const checkin = checkinInput.value;
            const checkout = checkoutInput.value;
            const roomsInput = document.getElementById('roomsCount').value;

            // Kiểm tra các trường đã nhập
            if (!checkin) {
                alert('Vui lòng chọn ngày nhận phòng.');
                return;
            }
            if (!checkout) {
                alert('Vui lòng chọn ngày trả phòng.');
                return;
            }
            if (!roomsInput || parseInt(roomsInput) < 1) {
                alert('Vui lòng chọn số phòng hợp lệ.');
                return;
            }

            // Kiểm tra ngày check-in không được nhỏ hơn hôm nay
            const today = new Date(getToday());
            const checkinDate = new Date(checkin);
            if (checkinDate < today) {
                alert('Ngày nhận phòng không được là ngày trong quá khứ.');
                return;
            }

            // Kiểm tra ngày check-out phải sau ngày check-in
            const checkoutDate = new Date(checkout);
            if (checkinDate >= checkoutDate) {
                alert('Ngày trả phòng phải sau ngày nhận phòng.');
                return;
            }

            updateDaysDisplay();
            form.submit();
        });

        // Các hàm khác như updateGuests, applySort, applyFilters giữ nguyên...
    });
</script>
</body>