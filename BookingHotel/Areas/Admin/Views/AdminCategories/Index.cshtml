@using BookingHotel.Areas.Admin.Models
@model IEnumerable<Category>

@{
    ViewData["Title"] = "Quản Lý Danh Mục";
}
<h1>Quản Lý Danh Mục</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">Tạo Danh Mục Mới</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Tên danh mục</th>
            <th>Mã danh mục</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.CategoryName</td>
                <td>@category.CategoryCode</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@category.CategoryId" class="btn btn-warning">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@category.CategoryId" class="btn btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>