            <!-- JavaScript để xử lý carousel -->
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const roomCarousel = document.getElementById('room-carousel');
                    const roomPrevBtn = document.getElementById('room-prev-btn');
                    const roomNextBtn = document.getElementById('room-next-btn');

                    const roomItems = roomCarousel.querySelectorAll('.room-card');
                    const roomItemWidth = 392 + 16; // Card width (392px) + gap (16px)
                    const roomVisibleItems = 3; // Hiển thị 3 phòng cùng lúc
                    let roomCurrentIndex = 0;
                    let roomTotalItems = roomItems.length;
                    let roomMaxIndex = roomTotalItems - roomVisibleItems;

                    // Đặt chiều rộng cho carousel
                    roomCarousel.style.width = `${roomTotalItems * roomItemWidth}px`;

                    function updateRoomCarousel() {
                        roomCarousel.style.transform = `translateX(${-roomCurrentIndex * roomItemWidth}px)`;

                        // Smooth button state transitions
                        roomPrevBtn.style.opacity = roomCurrentIndex === 0 ? '0.4' : '1';
                        roomPrevBtn.style.pointerEvents = roomCurrentIndex === 0 ? 'none' : 'auto';
                        roomPrevBtn.style.transform = roomCurrentIndex === 0 ? 'translateY(-50%) scale(0.9)' : 'translateY(-50%) scale(1)';

                        roomNextBtn.style.opacity = roomCurrentIndex >= roomMaxIndex ? '0.4' : '1';
                        roomNextBtn.style.pointerEvents = roomCurrentIndex >= roomMaxIndex ? 'none' : 'auto';
                        roomNextBtn.style.transform = roomCurrentIndex >= roomMaxIndex ? 'translateY(-50%) scale(0.9)' : 'translateY(-50%) scale(1)';
                    }

                    function goToRoomSlide(index) {
                        if (index < 0) {
                            roomCurrentIndex = Math.max(0, roomTotalItems - roomVisibleItems);
                        } else if (index > roomMaxIndex) {
                            roomCurrentIndex = 0;
                        } else {
                            roomCurrentIndex = index;
                        }
                        updateRoomCarousel();
                    }

                    roomPrevBtn.addEventListener('click', (e) => {
                        e.preventDefault();
                        goToRoomSlide(roomCurrentIndex - 1);
                    });

                    roomNextBtn.addEventListener('click', (e) => {
                        e.preventDefault();
                        goToRoomSlide(roomCurrentIndex + 1);
                    });

                    // Enhanced touch/swipe functionality
                    let touchStartX = 0;
                    let touchEndX = 0;
                    let isDragging = false;

                    roomCarousel.addEventListener('touchstart', (e) => {
                        touchStartX = e.changedTouches[0].screenX;
                        isDragging = true;
                    });

                    roomCarousel.addEventListener('touchmove', (e) => {
                        if (isDragging) {
                            e.preventDefault();
                        }
                    });

                    roomCarousel.addEventListener('touchend', (e) => {
                        if (!isDragging) return;
                        touchEndX = e.changedTouches[0].screenX;
                        handleRoomSwipe();
                        isDragging = false;
                    });

                    function handleRoomSwipe() {
                        const swipeThreshold = 75;
                        const swipeDistance = Math.abs(touchEndX - touchStartX);

                        if (swipeDistance > swipeThreshold) {
                            if (touchEndX < touchStartX) {
                                goToRoomSlide(roomCurrentIndex + 1);
                            } else {
                                goToRoomSlide(roomCurrentIndex - 1);
                            }
                        }
                    }

                    // Auto-play functionality (optional)
                    let autoPlayInterval;
                    const startAutoPlay = () => {
                        autoPlayInterval = setInterval(() => {
                            if (roomCurrentIndex >= roomMaxIndex) {
                                goToRoomSlide(0);
                            } else {
                                goToRoomSlide(roomCurrentIndex + 1);
                            }
                        }, 4000);
                    };

                    const stopAutoPlay = () => {
                        clearInterval(autoPlayInterval);
                    };

                    // Pause auto-play on hover
                    roomCarousel.addEventListener('mouseenter', stopAutoPlay);
                    roomCarousel.addEventListener('mouseleave', startAutoPlay);

                    // Khởi tạo
                    if (roomTotalItems > 0) {
                        updateRoomCarousel();
                        startAutoPlay(); // Start auto-play
                    }
                });
            </script>
        </section>

