@using BookingHotel.Areas.Admin.Models
@model Offer
@{
    ViewData["Title"] = "Xóa Ưu Đãi";
}
<h1>Xóa Ưu Đãi</h1>
<h3>Bạn có chắc chắn muốn xóa ưu đãi này?</h3>
<div>
    <h4>@Model.Title</h4>
    <dl class="row">
        <dt class="col-sm-2">Danh mục</dt>
        <dd class="col-sm-10">@Model.Category.CategoryName</dd>
        <dt class="col-sm-2">Mô tả</dt>
        <dd class="col-sm-10">@Model.Description</dd>
        <dt class="col-sm-2">Giảm giá</dt>
        <dd class="col-sm-10">@Model.DiscountPercentage%</dd>
    
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="OfferId" />
        <button type="submit" class="btn btn-danger">Xóa</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </form>
</div>