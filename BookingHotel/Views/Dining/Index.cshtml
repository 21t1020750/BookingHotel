@model BookingHotel.Areas.Admin.Models.DiningViewModel
@{
    ViewData["Title"] = "Trang Ẩm Thực";
}

<body class="bg-gray-50" alt="khách sạn sang trọng">
    <main>
        <!-- Hero Section -->
        <section class="relative h-96 bg-cover bg-center" style="background-image: url('/images/Cuisine/@(Model.HeroImage?.ImageURL ?? "default.jpg")');" alt="ẩm thực sang trọng">
            <div class="absolute inset-0 bg-black/20 flex items-center" alt="lớp phủ hero">
                <div class="mx-auto max-w-full w-[1200px] px-4 sm:px-6 lg:px-8 text-white">
                    <h2 class="text-4xl md:text-5xl font-bold mb-6">@(Model.HeroImage?.SectionTitle ?? "Trải Nghiệm Ẩm Thực Đỉnh Cao")</h2>
                    <p class="text-xl md:text-2xl max-w-2xl mb-8">@(Model.HeroImage?.Description ?? "Khám phá ẩm thực hàng đầu thế giới với hương vị Việt Nam đích thực và các món quốc tế")</p>
                </div>
            </div>
        </section>

        <!-- Restaurants Section -->
        <section class="py-20 bg-white" alt="phần nhà hàng">
            <div class="mx-auto max-w-full w-[1200px] px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-16">
                    <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">Nhà Hàng & Quán Bar Của Chúng Tôi</h2>
                    <div class="w-24 h-1 bg-blue-600 mx-auto mb-6" alt="đường phân cách"></div>
                    <p class="text-gray-600 max-w-3xl mx-auto">Khám phá bộ sưu tập các địa điểm ăn uống tinh tế, mỗi nơi mang đến trải nghiệm ẩm thực và không gian độc đáo.</p>
                </div>

                <div class="grid md:grid-cols-2 gap-8">
                    @foreach (var restaurant in Model.Restaurants)
                    {
                        <div class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300" alt="@restaurant.Restaurant.Name.ToLower()">
                            <div class="h-64 overflow-hidden">
                                <img src="/images/Cuisine/@restaurant.Restaurant.ImageURL" alt="@restaurant.Restaurant.Name.ToLower()" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500">
                            </div>
                            <div class="p-6">
                                <h3 class="text-2xl font-bold text-gray-800 mb-2">@restaurant.Restaurant.Name</h3>
                                <p class="text-gray-600 mb-4">@restaurant.Restaurant.Description</p>
                                <div class="flex flex-wrap gap-2 mb-4">
                                    @foreach (var tag in restaurant.Tags)
                                    {
                                        <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm" alt="@tag">@tag</span>
                                    }
                                </div>
                                <div class="flex justify-between items-center">
                                    <span class="text-gray-700"><i class="fas fa-clock text-blue-600 mr-1"></i> @restaurant.Restaurant.OperatingHours</span>
                                    <a href="#" class="text-blue-600 hover:text-blue-800 font-medium">Xem Thực Đơn →</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- Dishes Section -->
        <section class="py-20 bg-gray-100" alt="điểm nhấn ẩm thực">
            <div class="mx-auto max-w-full w-[1200px] px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-16">
                    <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">Điểm Nhấn Ẩm Thực</h2>
                    <div class="w-24 h-1 bg-blue-600 mx-auto mb-6" alt="đường phân cách"></div>
                    <p class="text-gray-600 max-w-3xl mx-auto">Khám phá các món đặc trưng và sáng tạo của đầu bếp, thể hiện tinh hoa ẩm thực Việt Nam và quốc tế.</p>
                </div>

                <div class="grid md:grid-cols-3 gap-8">
                    @foreach (var dish in Model.Dishes)
                    {
                        <div class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300" alt="@dish.Name.ToLower()">
                            <div class="h-64 overflow-hidden">
                                <img src="/images/Cuisine/@dish.ImageURL" alt="@dish.Name.ToLower()" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500">
                            </div>
                            <div class="p-6">
                                <h3 class="text-2xl font-bold text-gray-800 mb-2">@dish.Name</h3>
                                <p class="text-gray-600 mb-4">@dish.Description</p>
                                <div class="flex justify-between items-center">
                                    <span class="text-blue-600 font-bold">@dish.Label</span>
                                    <a href="#" class="text-blue-600 hover:text-blue-800 font-medium">Tìm Hiểu Thêm →</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    </main>
    <script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script>
</body>