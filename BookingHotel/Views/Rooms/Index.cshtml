@model List<BookingHotel.Areas.Admin.Models.RoomType>
@using BookingHotel.Areas.Admin.Models
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Trang Phòng Nghỉ";

}
<link rel="stylesheet" href="@Url.Content("~/css/Rooms.css")" />

<body class="font-inter bg-gray-50">
    <section class="relative h-screen parallax-bg" style="background-image: url('https://images.unsplash.com/photo-1578683010236-d716f9a3f461?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3MzY5OTh8MHwxfHNlYXJjaHw0fHxsdXh1cnklMjByb29tfGVufDB8fHx8MTc0NTkxMTc2NXww&ixlib=rb-4.0.3&q=85');">
        <div class="relative h-full flex items-center justify-center">
            <div class="text-center text-white px-4 floating-animation">
                <div class="glass-effect rounded-3xl p-8 md:p-12 max-w-4xl mx-auto">
                    <h1 class="font-playfair text-5xl md:text-7xl font-bold mb-6">
                        Phòng Nghỉ <span class="text-gradient">Tinh Tế</span>
                    </h1>
                    <p class="text-xl md:text-2xl mb-8 text-gray-200 font-light leading-relaxed">
                        Khám phá bộ sưu tập các phòng và suite được thiết kế tỉ mỉ,
                        nơi sang trọng gặp gỡ sự thoải mái hoàn hảo
                    </p>
                    <a asp-controller="Find_Room" asp-action="Index"
                       class="btn-primary text-white px-8 py-4 rounded-full font-semibold text-lg shadow-lg inline-block text-center">
                        Khám Phá Ngay
                    </a>
                </div>
            </div>
            <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 text-white animate-bounce">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                </svg>
            </div>
        </div>
    </section>

    <section class="py-20 section-bg" alt="danh mục phòng">
        <div class="container-fixed">
            <div class="text-center mb-20 fade-in" id="header">
                <h2 class="text-4xl md:text-6xl font-playfair font-bold bg-gradient-to-r from-gray-800 to-gray-600 bg-clip-text text-transparent mb-6">
                    Phòng & Suite Của Chúng Tôi
                </h2>
                <div class="flex items-center justify-center mb-8">
                    <div class="w-16 h-0.5 bg-gradient-to-r from-transparent to-blue-600"></div>
                    <div class="w-8 h-8 mx-4 bg-gradient-to-r from-blue-600 to-emerald-500 rounded-full flex items-center justify-center">
                        <div class="w-2 h-2 bg-white rounded-full"></div>
                    </div>
                    <div class="w-16 h-0.5 bg-gradient-to-l from-transparent to-emerald-500"></div>
                </div>
                <p class="text-gray-600 max-w-4xl mx-auto text-lg leading-relaxed">
                    Mỗi không gian được thiết kế chu đáo để mang lại sự thoải mái vượt trội với sự kết hợp hoàn hảo giữa sang trọng hiện đại và thẩm mỹ truyền thống Việt Nam.
                </p>
            </div>

            @foreach (var roomType in Model)
            {
                var room = roomType.Rooms.FirstOrDefault();
                if (room == null) { continue; }

                var mainImage = string.IsNullOrEmpty(room.Photo)
                ? "https://via.placeholder.com/1587x800?text=No+Image"
                : $"/images/room/{Uri.EscapeDataString(room.Photo)}";

                // Tính giá thấp nhất và cao nhất trong cùng RoomType
                var minPrice = roomType.Rooms.Any() ? roomType.Rooms.Min(r => r.Price) : 0;
                var maxPrice = roomType.Rooms.Any() ? roomType.Rooms.Max(r => r.Price) : 0;

                <section class="section-bg section-@roomType.RoomTypeID">
                    <div class="collage-section">
                        <div class="collage-image main-image">
                            <img src="@Url.Content(mainImage)" alt="@roomType.TypeName main" />
                        </div>
                        <div class="info-card">
                            <h3 class="room-title">@roomType.TypeName</h3>
                            <p class="room-description">
                                @roomType.Description
                            </p>
                            <div class="price-text">
                                @(roomType.Rooms.Any() ? $"Từ ${minPrice} - ${maxPrice}/đêm" : "Giá không khả dụng")
                            </div>
                            <button class="btn-custom">Xem thêm chi tiết</button>
                        </div>
                        <div class="sub-images-container">
                            @{
                                var subRooms = roomType.Rooms.Skip(1).Take(3).ToList();
                                for (int i = 0; i < 3; i++)
                                {
                                    var subImage = subRooms.Count > i && !string.IsNullOrEmpty(subRooms[i].Photo)
                                    ? $"/images/room/{Uri.EscapeDataString(subRooms[i].Photo)}"
                                    : "https://via.placeholder.com/400x300?text=No+Image";
                                    var altText = $"{roomType.TypeName} room-{(subRooms.Count > i ? subRooms[i].RoomNumber : "noimage")}";
                                    <div class="collage-image sub-image @(i == 2 ? "last-image" : "")">
                                        <img src="@Url.Content(subImage)" alt="@altText" />
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </section>
            }
        </div>
    </section>

    <script>
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, observerOptions);
        document.querySelectorAll('.fade-in').forEach(el => {
            observer.observe(el);
        });
    </script>
</body>