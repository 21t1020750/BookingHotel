@using System.Security.Claims
@{
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
    var fullName = User.Identity.Name;
    var photo = User.FindFirst("Photo")?.Value;
    var currentPath = Context.Request.Path.ToString().ToLower();
}

<!-- CSS Sticky & Blur -->
<link rel="stylesheet" href="~/css/PageCSS/_MainHeader2.css" />
<link rel="stylesheet" href="~/css/PageCSS/_Language.css" />

<header class="bg-cyan-600 text-white py-7">
    <div class="mx-auto max-w-full w-[1200px] px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between">
            <!-- Logo -->
            <a href="~/" class="flex items-center text-white no-underline">
                <i class="fas fa-hotel text-white text-4xl md:text-4xl mr-2"></i>
                <span class="text-4xl md:text-4xl font-bold">VietNamBooking</span>
            </a>

            <!-- Mobile Menu Button -->
            <div class="lg:hidden">
                <button id="menu-toggle" class="text-white text-4xl focus:outline-none">
                    <span id="menu-icon">☰</span>
                </button>
            </div>

            <!-- Desktop Navigation -->
            <nav id="desktop-nav" class="hidden md:flex md:items-center md:space-x-12 flex-1 justify-center">
                <div class="group nav-link @(currentPath == "/" ? "active" : "")">
                    <a href="~/" class="text-2xl md:text-4xl font-medium hover:text-gray-200 transition shrink-0">Trang chủ</a>
                    <span class="underline absolute bottom-0 left-0 w-0 h-3px bg-ffcc99 transition"></span>
                </div>
                <div class="group nav-link @(currentPath.StartsWith("/rooms") ? "active" : "")">
                    <a href="~/Rooms" class="text-2xl md:text-4xl font-medium hover:text-gray-200 transition shrink-0">Phòng</a>
                    <span class="underline absolute bottom-0 left-0 w-0 h-3px bg-ffcc99 transition"></span>
                </div>
                <div class="group nav-link @(currentPath.StartsWith("/dining") ? "active" : "")">
                    <a href="~/Dining" class="text-2xl md:text-4xl font-medium hover:text-gray-200 transition shrink-0">Ẩm thực</a>
                    <span class="underline absolute bottom-0 left-0 w-0 h-3px bg-ffcc99 transition"></span>
                </div>
                <div class="group nav-link @(currentPath.StartsWith("/facilities") ? "active" : "")">
                    <a href="~/Facilities" class="text-2xl md:text-4xl font-medium hover:text-gray-200 transition shrink-0">Tiện ích</a>
                    <span class="underline absolute bottom-0 left-0 w-0 h-3px bg-ffcc99 transition"></span>
                </div>
                <div class="group nav-link @(currentPath.StartsWith("/offers") ? "active" : "")">
                    <a href="~/Offers" class="text-2xl md:text-4xl font-medium hover:text-gray-200 transition shrink-0">Ưu đãi</a>
                    <span class="underline absolute bottom-0 left-0 w-0 h-3px bg-ffcc99 transition"></span>
                </div>
                <div class="group nav-link @(currentPath.StartsWith("/contact") ? "active" : "")">
                    <a href="~/Contact" class="text-2xl md:text-4xl font-medium hover:text-gray-200 transition shrink-0">Liên hệ</a>
                    <span class="underline absolute bottom-0 left-0 w-0 h-3px bg-ffcc99 transition"></span>
                </div>
            </nav>

            <div id="desktop-auth" class="hidden md:flex items-center space-x-6 justify-end">
                <!-- Ngôn ngữ + icon -->
                <div class="relative inline-block text-left">
                    <button id="lang-toggle" type="button" class="inline-flex items-center space-x-2 bg-cyan-600 text-white px-4 py-2 rounded hover:bg-cyan-700 focus:outline-none">
                        <i class="fas fa-globe"></i>
                        <span id="current-lang">EN</span>
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.23 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd" />
                        </svg>
                    </button>

                    <div id="lang-menu" class="hidden absolute right-0 mt-2 w-24 bg-white rounded shadow-lg z-10 transition duration-150 ease-in-out">
                        <a href="/lang/en" data-lang="EN"
                           class="block w-full text-center px-2 py-2 text-2xl text-gray-700 hover:bg-gray-100 transition">EN</a>
                        <a href="/lang/vi" data-lang="VI"
                           class="block w-full text-center px-2 py-2 text-2xl text-gray-700 hover:bg-gray-100 transition">VI</a>
                    </div>
                </div>

                @if (User.Identity.IsAuthenticated && role == "Customer")
                {
                    <div class="relative inline-block text-left">
                        <!-- Avatar + Tên người dùng -->
                        <button id="userDropdown" class="flex items-center space-x-4 focus:outline-none min-w-[100px] justify-end">
                            <img src="~/images/Customer/@photo" class="rounded-full" width="35" height="35" alt="User Avatar">
                            <span class="text-xl whitespace-nowrap">Xin chào, @fullName</span>
                        </button>

                        <!-- Dropdown menu -->
                        <div id="dropdownMenu" class="hidden absolute right-0 mt-2 w-[22rem] bg-white rounded-md shadow-lg z-50 text-lg">
                            <div class="p-6 border-b">
                                <div class="flex items-center">
                                    <img src="~/images/Customer/@photo" class="w-15 h-20 rounded-full object-cover mr-4" alt="User Avatar">
                                    <div>
                                        <div class="flex items-center">
                                            <h4 class="font-semibold text-xl text-gray-800">@fullName</h4>
                                            <span class="ml-3 bg-yellow-100 text-yellow-800 text-sm px-3 py-1 rounded-full">Gold</span>
                                        </div>
                                        <p class="text-base text-gray-600 mt-2">Điểm tích luỹ: 1200 điểm</p>
                                    </div>
                                </div>
                            </div>

                            <a href="@Url.Action("Index", "Information")" onclick="switchTab('profile')"
                               class="grid grid-cols-[auto_1fr] gap-x-4 items-center px-6 py-3 text-gray-700 hover:bg-gray-100 text-2xl">
                                <i class="fas fa-user-circle text-blue-500 mr-4 text-2xl"></i>
                                <span>Thông tin cá nhân</span>
                            </a>

                            <a href="@Url.Action("Index", "Information")#rewards" onclick="switchTab('rewards')"
                               class="grid grid-cols-[auto_1fr] gap-x-4 items-center px-6 py-3 text-gray-700 hover:bg-gray-100 text-2xl">
                                <i class="fas fa-gift text-blue-500 mr-4 text-2xl"></i>
                                <span>Ưu đãi</span>
                            </a>

                            <a href="@Url.Action("Index", "Information")#reviews" onclick="switchTab('reviews')"
                               class="grid grid-cols-[auto_1fr] gap-x-4 items-center px-6 py-3 text-gray-700 hover:bg-gray-100 text-2xl">
                                <i class="fas fa-star text-blue-500 mr-4 text-2xl"></i>
                                <span>Đánh giá</span>
                            </a>

                            <a href="@Url.Action("Index", "Information")#history" onclick="switchTab('history')"
                               class="grid grid-cols-[auto_1fr] gap-x-4 items-center px-6 py-3 text-gray-700 hover:bg-gray-100 text-2xl">
                                <i class="fas fa-history text-blue-500 mr-4 text-2xl"></i>
                                <span>Lịch sử</span>
                            </a>

                            <a href="~/Account/Logout"
                               class="grid grid-cols-[auto_1fr] gap-x-4 items-center px-6 py-3 text-gray-700 hover:bg-gray-100 text-2xl">
                                <i class="fas fa-sign-out-alt text-blue-500 mr-4 text-2xl"></i>
                                <span>Đăng xuất</span>
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex space-x-2">
                        <a href="~/Account/Login?tab=login" class="bg-white text-[#003087] px-4 py-2 rounded-xl text-2xl font-medium hover:text-white hover:bg-[#e55b00] transition duration-300">Đăng nhập</a>
                        <a href="~/Account/Login?tab=register" class="bg-white text-[#003087] px-4 py-2 rounded-xl text-2xl font-medium hover:text-white hover:bg-[#e55b00] transition duration-300">Đăng ký</a>
                    </div>
                }
            </div>
        </div>

        <!-- Mobile Navigation (Hidden by default) -->
        <nav id="mobile-menu" class="lg:hidden max-h-0 overflow-hidden transition-all duration-300 mt-4 space-y-4 text-center">
            <a href="~/" class="bg-cyan-600 text-white px-3 py-1 rounded-xl text-2xl font-medium hover:bg-gray-100 transition block nav-link @(currentPath == "/" ? "active" : "")">Trang chủ</a>
            <a href="~/Rooms" class="bg-cyan-600 text-white px-3 py-1 rounded-xl text-2xl font-medium hover:bg-gray-100 transition block nav-link @(currentPath.StartsWith("/rooms") ? "active" : "")">Phòng</a>
            <a href="~/Dining" class="bg-cyan-600 text-white px-3 py-1 rounded-xl text-2xl font-medium hover:bg-gray-100 transition block nav-link @(currentPath.StartsWith("/dining") ? "active" : "")">Ẩm thực</a>
            <a href="~/Facilities" class="bg-cyan-600 text-white px-3 py-1 rounded-xl text-2xl font-medium hover:bg-gray-100 transition block nav-link @(currentPath.StartsWith("/facilities") ? "active" : "")">Tiện ích</a>
            <a href="~/Offers" class="bg-cyan-600 text-white px-3 py-1 rounded-xl text-2xl font-medium hover:bg-gray-100 transition block nav-link @(currentPath.StartsWith("/offers") ? "active" : "")">Ưu đãi</a>
            <a href="~/Contact" class="bg-cyan-600 text-white px-3 py-1 rounded-xl text-2xl font-medium hover:bg-gray-100 transition block nav-link @(currentPath.StartsWith("/contact") ? "active" : "")">Liên hệ</a>
            @if (Context.Session.GetString("Email") != null)
            {
                <a href="@Url.Action("Logout", "Account")" class="bg-cyan-600 text-white px-3 py-1 rounded-xl text-2xl font-medium hover:bg-gray-100 transition block">Đăng Xuất</a>
            }
            else
            {
                <a href="~/Account/Login?tab=login" class="bg-cyan-600 text-white px-3 py-1 rounded-xl text-2xl font-medium hover:bg-gray-100 transition block">Đăng Nhập</a>
                <a href="~/Account/Login?tab=register" class="bg-cyan-600 text-white px-3 py-1 rounded-xl text-2xl font-medium hover:bg-gray-100 transition block">Đăng Ký</a>
            }
        </nav>
    </div>
</header>

    <script>

        document.addEventListener("DOMContentLoaded", function () {
            // Xử lý dropdown người dùng
            const userDropdown = document.getElementById("userDropdown");
            const dropdownMenu = document.getElementById("dropdownMenu");
            const langToggle = document.getElementById("lang-toggle");
            const langMenu = document.getElementById("lang-menu");
            const currentLang = document.getElementById("current-lang");

            // Dropdown người dùng
            userDropdown?.addEventListener("click", function (event) {
                event.stopPropagation();
                dropdownMenu?.classList.toggle("hidden");
            });

            document.addEventListener("click", function () {
                dropdownMenu?.classList.add("hidden");
                langMenu?.classList.add("hidden");
            });

            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") {
                    dropdownMenu?.classList.add("hidden");
                    langMenu?.classList.add("hidden");
                }
            });

            // Dropdown ngôn ngữ
            langToggle?.addEventListener("click", function (event) {
                event.stopPropagation();
                langMenu?.classList.toggle("hidden");
            });

            // Xử lý chọn ngôn ngữ
            langMenu?.querySelectorAll("a").forEach(function (link) {
                link.addEventListener("click", function (event) {
                    event.preventDefault();
                    const selectedLang = this.getAttribute("data-lang");
                    currentLang.textContent = selectedLang;
                    window.location.href = this.getAttribute("href");
                });
            });
        });

        // Hàm chuyển tab toàn cục
        function switchTab(tabId) {
            // Nếu đang ở trang Index.cshtml
            if (window.location.pathname.includes('/Information/Index')) {
                if (typeof activateTab === 'function') {
                    activateTab(tabId);
                } else {
                    // Fallback thủ công
                    const sections = ['profile', 'bookings', 'history', 'reviews', 'security', 'rewards'];
                    const tabs = document.querySelectorAll('.nav-tab');
                    if (sections.includes(tabId)) {
                        tabs.forEach(t => t.classList.remove('active'));
                        const activeTab = Array.from(tabs).find(tab => tab.getAttribute('href').substring(1) === tabId);
                        if (activeTab) {
                            activeTab.classList.add('active');
                        }
                        sections.forEach(section => {
                            const element = document.getElementById(section);
                            if (element) {
                                if (section === tabId) {
                                    element.classList.remove('hidden');
                                } else {
                                    element.classList.add('hidden');
                                }
                            }
                        });
                    }
                }

                // Hash hiện tại
                const currentHash = window.location.hash.substring(1);
                if (currentHash !== tabId) {
                    window.location.hash = tabId;
                } else {
                    // Kích hoạt lại nếu hash không đổi
                    window.dispatchEvent(new HashChangeEvent("hashchange"));
                }
            } else {
                // Nếu đang ở trang khác, chuyển hướng sang Index
                window.location.href = `/Information/Index#${tabId}`;
            }
        }
    </script>



<!-- JS Toggle Menu and Handle Resize -->
<script src="~/js/PageJS/_MainHeader2.js"></script>