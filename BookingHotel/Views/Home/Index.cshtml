@model BookingHotel.Models.HomeViewModel
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewBag.Title = "Trang chủ";
}
<body class="bg-gray-50" alt="khách sạn sang trọng">
    <main>
        <section class="relative text-white py-16 min-h-[50vh] flex items-center overflow-hidden">
            <!-- Background slider -->
            <div class="absolute inset-0 overflow-hidden z-0 rounded-b-xl">
                <div id="slider" class="w-full h-full flex transition-transform duration-700">
                    <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c" class="w-full flex-shrink-0 object-cover rounded-b-xl" />
                    <img src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb" class="w-full flex-shrink-0 object-cover rounded-b-xl" />
                    <img src="https://images.unsplash.com/photo-1593297237733-184d3ff53d80?q=80&w=2072&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" class="w-full flex-shrink-0 object-cover rounded-b-xl" />
                    <img src="https://du-lich.chudu24.com/f/m/2304/24/khach-san-hoang-hon-tim-boutique-phu-quoc-2.jpg?h=532&w=800" class="w-full flex-shrink-0 object-cover rounded-b-xl" />
                </div>
            </div>
            <div class="pagination absolute z-10">
            </div>
            <!-- CSS  -->
            <link rel="stylesheet" href="~/css/PageCSS/background.css" />
            <!-- JavaScript -->
            <script src="~/js/PageJS/background.js"></script>

            <div class="container relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                <h1 class="text-4xl sm:text-5xl xl:text-6xl font-extrabold tracking-tight leading-tight font-['Inter']">
                    Đặt phòng khách sạn dễ dàng nhất
                </h1>
                <p class="mt-6 max-w-lg mx-auto text-3xl sm:text-xl lg:text-2xl leading-relaxed">
                    Khách sạn từ bình dân đến cao cấp với giá tốt nhất
                </p>
                <div class="mt-10 sm:mt-12 max-w-md mx-auto sm:max-w-none sm:flex sm:justify-center sm:gap-6">
                    <a asp-controller="Find_Room" asp-action="Index"
                       class="w-full sm:w-auto bg-cyan-600 text-white rounded-xl py-8 sm:py-4 px-6 sm:px-20 text-sm sm:text-2xl font-medium hover:bg-cyan-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-cyan-500 transition duration-200 btn-hover">
                        <i class="fas fa-search mr-2"></i> Tìm khách sạn
                    </a>
                    <a asp-controller="Offers" asp-action="Index"
                       class="w-full sm:w-auto bg-cyan-600 text-white rounded-xl py-8 sm:py-4 px-6 sm:px-20 text-sm sm:text-2xl font-medium hover:bg-cyan-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-cyan-500 transition duration-200 btn-hover">
                        <i class="fas fa-percent mr-2"></i> Ưu đãi hôm nay
                    </a>
                </div>
            </div>
        </section>
        <!-- Search Section -->
        <div id="searchBar" class="text-lg normal bg-white shadow-2xl -mt-12 mx-auto max-w-full w-[1200px] rounded-2xl p-4 sm:p-5 relative z-10">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 sm:gap-6">
                <div>
                    <label for="checkin" class="block text-xl sm:text-2xl font-medium text-gray-700">Ngày nhận phòng</label>
                    <div class="mt-2 relative rounded-lg shadow-sm">
                        <input type="date"
                               id="checkin"
                               onkeydown="return false"
                               onfocus="this.showPicker()"
                               class="focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 border border-gray-300 block w-full pl-4 pr-12 py-3 sm:py-4 text-sm sm:text-2xl rounded-lg transition duration-200" />
                    </div>
                </div>
                <div class="relative w-full">
                    <label for="checkout" class="block text-xl sm:text-2xl font-medium text-gray-700">Ngày trả phòng</label>
                    <div class="mt-2 relative rounded-lg shadow-sm">
                        <input type="date"
                               id="checkout"
                               onkeydown="return false"
                               onfocus="this.showPicker()"
                               class="focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 border border-gray-300 block w-full pl-4 pr-4 py-3 sm:py-4 text-sm sm:text-2xl rounded-lg transition duration-200" />
                    </div>
                </div>             
                <style>
                    input[type="date"]::-webkit-calendar-picker-indicator {
                        position: absolute;
                        right: 12px;
                        z-index: 10;
                    }
                </style>
                <div class="relative">
                    <label for="guests" class="block text-xl sm:text-2xl font-medium text-gray-700">Số người</label>
                    <div class="mt-2 relative rounded-lg shadow-sm bg-white">
                        <button id="guestsBtn"
                                class="focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 border border-gray-300 block w-full pl-4 pr-4 py-3 sm:py-4 text-sm sm:text-2xl rounded-lg transition duration-200 text-left flex items-center justify-between whitespace-nowrap overflow-hidden">
                            <span id="guestsSummary" class="truncate">
                                1 Người lớn | 0 Trẻ em | 1 Phòng
                            </span>
                            <i class="fas fa-chevron-down text-cyan-500 text-2xl sm:text-3xl"></i>
                        </button>


                        <div id="guestsDropdown" class="absolute hidden w-full mt-2 bg-white border border-gray-300 rounded-lg shadow-lg z-20 p-4">
                            <div class="mb-4">
                                <div class="flex justify-between items-center">
                                    <label class="text-3xl font-normal text-gray-700">Người lớn</label>
                                    <div class="flex items-center rounded-lg overflow-hidden border border-gray-300 w-fit">
                                        <button onclick="updateGuests('adults', -1)"
                                                class="w-14 h-14 text-2xl bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none">
                                            -
                                        </button>
                                        <input type="number" id="adultsCount"
                                               class="w-20 h-14 text-center text-2xl bg-white text-gray-700 font-normal border-none focus:ring-0 no-spinner"
                                               value="1" min="1" oninput="updateGuests('adults', 0)">
                                        <button onclick="updateGuests('adults', 1)"
                                                class="w-14 h-14 text-2xl bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none">
                                            +
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-4">
                                <div class="flex justify-between items-center">
                                    <label class="text-3xl font-normal text-gray-700">Người lớn</label>
                                    <div class="flex items-center rounded-lg overflow-hidden border border-gray-300 w-fit">
                                        <button onclick="updateGuests('children', -1)"
                                                class="w-14 h-14 text-2xl bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none">
                                            -
                                        </button>
                                        <input type="number" id="childrenCount"
                                               class="w-20 h-14 text-center text-2xl bg-white text-gray-700 font-normal border-none focus:ring-0 no-spinner"
                                               value="1" min="1" oninput="updateGuests('children', 0)">
                                        <button onclick="updateGuests('children', 1)"
                                                class="w-14 h-14 text-2xl bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none">
                                            +
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-4">
                                <div class="flex justify-between items-center">
                                    <label class="text-3xl font-normal text-gray-700">Phòng</label>
                                    <div class="flex items-center rounded-lg overflow-hidden border border-gray-300 w-fit">
                                        <button onclick="updateGuests('rooms', -1)"
                                                class="w-14 h-14 text-2xl bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none">
                                            -
                                        </button>
                                        <input type="number" id="roomsCount"
                                               class="w-20 h-14 text-center text-2xl bg-white text-gray-700 font-normal border-none focus:ring-0 no-spinner"
                                               value="1" min="1" oninput="updateGuests('rooms', 0)">
                                        <button onclick="updateGuests('rooms', 1)"
                                                class="w-14 h-14 text-2xl bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none">
                                            +
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <button onclick="closeGuestsDropdown()" class="w-full bg-cyan-600 text-white rounded-lg py-2 text-2xl font-medium hover:bg-cyan-700">DONE</button>
                        </div>
                    </div>
                </div>
                <div class="flex items-end">
                    <a asp-controller="Find_Room" asp-action="Index"
                       class="w-full bg-cyan-600 text-white rounded-xl py-4 sm:py-4 px-6 text-sm sm:text-2xl font-medium hover:bg-cyan-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-cyan-500 transition duration-200 btn-hover flex justify-center items-center">
                        <i class="fas fa-search mr-2"></i> Tìm kiếm
                    </a>
                </div>
            </div>
        </div>

        <link rel="stylesheet" href="@Url.Content("~/css/PageCSS/SearchSection.css")" />
        <script src="@Url.Content("~/js/PageJS/SearchSection.js")"></script>

        <section class="py-20 bg-gray-100" alt="phần hình ảnh">
            <div class="mx-auto max-w-full w-[1200px] px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-16">
                    <h2 class="text-4xl md:text-4xl font-bold text-gray-800 mb-4">ĐỊA ĐIỂM NỔI BẬT</h2>
                    <div class="w-24 h-1 bg-blue-600 mx-auto mb-6" alt="đường phân cách"></div>
                    <p class="text-gray-600 max-w-3xl mx-auto text-3xl">Khám phá những không gian tuyệt đẹp làm nên tên tuổi của khách sạn</p>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
