    <script>
        const minInput = document.getElementById('minPrice');
        const maxInput = document.getElementById('maxPrice');
        const rangeMin = document.getElementById('priceRangeMin');
        const rangeMax = document.getElementById('priceRangeMax');

        function syncPriceInputs() {
            let min = parseInt(minInput.value) || 0;
            let max = parseInt(maxInput.value) || 10000000;

            // Đảm bảo min <= max
            if (min > max) {
                [min, max] = [max, min];
                alert('Giá tối thiểu đã được điều chỉnh để nhỏ hơn hoặc bằng giá tối đa.');
            }

            rangeMin.value = min;
            rangeMax.value = max;
        }
        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }
        function syncPriceSliders() {
            let min = parseInt(rangeMin.value);
            let max = parseInt(rangeMax.value);

            if (min > max) {
                [min, max] = [max, min];
            }

            minInput.value = min;
            maxInput.value = max;
        }

        // Sự kiện thay đổi input
        minInput.addEventListener('input', debounce(syncPriceInputs, 300));
        maxInput.addEventListener('input', debounce(syncPriceInputs, 300));
        rangeMin.addEventListener('input', debounce(syncPriceSliders, 300));
        rangeMax.addEventListener('input', debounce(syncPriceSliders, 300));

        // Nút chọn nhanh
        function setQuickPrice(min, max) {
            minInput.value = min;
            maxInput.value = max;
            rangeMin.value = min;
            rangeMax.value = max;
            document.getElementById('searchForm').submit();
        }
    </script>

