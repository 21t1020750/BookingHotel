<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Các mã JavaScript khác (guests, smooth scroll, v.v.) giữ nguyên...

        // Xử lý ngày check-in và check-out
        const checkinInput = document.getElementById('checkin');
        const checkoutInput = document.getElementById('checkout');

        // Hàm lấy ngày hiện tại dưới định dạng yyyy-MM-dd
        function getToday() {
            const today = new Date();
            return today.toISOString().split('T')[0];
        }

        // Hàm cập nhật ngày tối thiểu cho check-out
        function updateCheckoutMinDate() {
            const checkinDate = checkinInput.value;
            if (checkinDate) {
                const minCheckoutDate = new Date(checkinDate);
                minCheckoutDate.setDate(minCheckoutDate.getDate() + 1);
                checkoutInput.min = minCheckoutDate.toISOString().split('T')[0];

                // Kiểm tra nếu ngày check-out hiện tại không hợp lệ
                if (checkoutInput.value && new Date(checkoutInput.value) <= new Date(checkinDate)) {
                    checkoutInput.value = minCheckoutDate.toISOString().split('T')[0];
                    alert('Ngày trả phòng phải sau ngày nhận phòng. Ngày trả phòng đã được điều chỉnh.');
                }
            } else {
                checkoutInput.min = getToday();
            }
        }

        // Kiểm tra khi chọn ngày check-out
        checkoutInput.addEventListener('change', () => {
            if (!checkinInput.value) {
                alert('Vui lòng chọn ngày nhận phòng.');
                checkoutInput.value = '';
            } else {
                updateCheckoutMinDate();
            }
        });

        // Đặt ngày tối thiểu cho check-in là hôm nay
        checkinInput.min = getToday();

        // Cập nhật ngày tối thiểu cho check-out khi check-in thay đổi
        checkinInput.addEventListener('change', updateCheckoutMinDate);

        // Khởi tạo ngày tối thiểu cho check-out khi tải trang
        updateCheckoutMinDate();

        // Cập nhật hàm submit form để kiểm tra ngày
        const form = document.getElementById('searchForm');
        form.addEventListener('submit', (e) => {
            e.preventDefault();

            const checkin = checkinInput.value;
            const checkout = checkoutInput.value;
            const roomsInput = document.getElementById('roomsCount').value;

            // Kiểm tra các trường đã nhập
            if (!checkin) {
                alert('Vui lòng chọn ngày nhận phòng.');
                return;
            }
            if (!checkout) {
                alert('Vui lòng chọn ngày trả phòng.');
                return;
            }
            if (!roomsInput || parseInt(roomsInput) < 1) {
                alert('Vui lòng chọn số phòng hợp lệ.');
                return;
            }

            // Kiểm tra ngày check-in không được nhỏ hơn hôm nay
            const today = new Date(getToday());
            const checkinDate = new Date(checkin);
            if (checkinDate < today) {
                alert('Ngày nhận phòng không được là ngày trong quá khứ.');
                return;
            }

            // Kiểm tra ngày check-out phải sau ngày check-in
            const checkoutDate = new Date(checkout);
            if (checkinDate >= checkoutDate) {
                alert('Ngày trả phòng phải sau ngày nhận phòng.');
                return;
            }

            updateDaysDisplay();
            form.submit();
        });

        // Các hàm khác như updateGuests, applySort, applyFilters giữ nguyên...
    });
</script>
