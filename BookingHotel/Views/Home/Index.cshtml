                                <h3 class="text-2xl font-bold text-gray-800 mb-2">@room.RoomType.TypeName</h3>
                                <p class="text-gray-600 mb-4 text-2xl">@room.RoomType.Description</p>
                                <div class="flex justify-between items-center">
                                    <span class="text-blue-600 font-bold text-3xl">Từ @room.Price VNĐ/đêm</span>
                                    <a href="#" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition" alt="Xem Chi Tiết">Xem Chi Tiết</a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p>Không có phòng để hiển thị.</p>
                }
            </div>
        </section>

        <section class="bg-gray-100 py-16" alt="Tiện Ích Phòng">
            <div class="mx-auto max-w-full w-[1200px] px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2 class="text-4xl md:text-5xl font-bold text-gray-800 mb-6">TIỆN TÍCH PHÒNG</h2>
                    <p class="text-gray-600 max-w-5xl mx-auto text-4xl md:text-3xl mt-8">Tất cả phòng của chúng tôi đều được trang bị tiện nghi cao cấp cho sự thoải mái của bạn</p>
                </div>
                <div class="carousel-container mx-auto w-[1200px] relative">
                    <div class="carousel-wrapper overflow-hidden">
                        <div id="amenitiesCarousel" class="carousel flex gap-8 transition-transform duration-700 ease-out">
                            @if (Model.Amenities != null && Model.Amenities.Any())
                            {
                                @foreach (var amenity in Model.Amenities)
                                {
                                    <div class="amenity-card bg-white p-6 rounded-lg shadow-sm text-center flex-shrink-0 w-[280px]" alt="@amenity.Name">
                                        <i class="@amenity.Icon text-4xl text-blue-500 mb-4"></i>
                                        <h3 class="text-lg font-semibold text-gray-800 mb-2">@amenity.Name</h3>
                                        <p class="text-gray-600">@amenity.Description</p>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="w-full text-center">Không có tiện ích để hiển thị.</p>
                            }
                        </div>
                    </div>
                    <!-- Nút mũi tên trái -->
                    <button id="amenitiesPrevBtn" class="carousel-nav-btn prev-btn">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <!-- Nút mũi tên phải -->
                    <button id="amenitiesNextBtn" class="carousel-nav-btn next-btn">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>

            <!-- CSS cho carousel -->
            <style>
                .amenity-card {
                    position: relative;
                    border-radius: 12px;
                    overflow: hidden;
                    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
                    transition: all 0.4s ease;
                    cursor: pointer;
                    flex: 0 0 auto;
                    width: 280px;
                    height: auto;
                }

                

                .carousel-container {
                    position: relative;
                    overflow: hidden;
                    width: 1200px;
                    margin: 0 auto;
                }

                .carousel-wrapper {
                    overflow: hidden;
                    width: 100%;
                }

                .carousel {
                    display: flex;
                    gap: 26px;
                    transition: transform 0.5s ease;
                }

                .carousel-nav-btn {
                    position: absolute;
                    top: 50%;
                    transform: translateY(-50%);
                    width: 48px;
                    height: 48px;
                    border-radius: 50%;
                    background-color: rgba(255,255,255,0.95);
                    color: #1a56db;
                    border: none;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    cursor: pointer;
                    z-index: 10;
                    box-shadow: 0 0 6px rgba(0,0,0,0.2);
