@model BookingHotel.Models.HomeViewModel
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewBag.Title = "Trang chủ";
}
<body class="bg-gray-50" alt="khách sạn sang trọng">
    <main>
        <!-- Hero Section với Background Slider -->
        <section class="relative text-white py-24 min-h-[70vh] flex items-center overflow-hidden">
            <!-- Background slider với hiệu ứng gradient overlay -->
            <div class="absolute inset-0 overflow-hidden z-0">
                <div id="slider" class="w-full h-full flex transition-transform duration-1000">
                    <div class="w-full flex-shrink-0 relative">
                        <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c" class="w-full h-full object-cover" />
                        <div class="absolute inset-0 bg-gradient-to-r from-black/60 to-transparent"></div>
                    </div>
                    <div class="w-full flex-shrink-0 relative">
                        <img src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb" class="w-full h-full object-cover" />
                        <div class="absolute inset-0 bg-gradient-to-r from-black/60 to-transparent"></div>
                    </div>
                    <div class="w-full flex-shrink-0 relative">
                        <img src="https://images.unsplash.com/photo-1593297237733-184d3ff53d80?q=80&w=2072&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" class="w-full h-full object-cover" />
                        <div class="absolute inset-0 bg-gradient-to-r from-black/60 to-transparent"></div>
                    </div>
                    <div class="w-full flex-shrink-0 relative">
                        <img src="https://du-lich.chudu24.com/f/m/2304/24/khach-san-hoang-hon-tim-boutique-phu-quoc-2.jpg?h=532&w=800" class="w-full h-full object-cover" />
                        <div class="absolute inset-0 bg-gradient-to-r from-black/60 to-transparent"></div>
                    </div>
                </div>
            </div>
            <div class="pagination absolute z-10">
            </div>
            <!-- CSS  -->
            <link rel="stylesheet" href="~/css/PageCSS/background.css" />
            <!-- JavaScript -->
            <script src="~/js/PageJS/background.js"></script>

            <div class="container relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center md:text-left">
                <h1 class="text-5xl sm:text-6xl xl:text-7xl font-extrabold tracking-tight leading-tight mb-6 font-['Inter']">
                    <span class="block text-white">Khám Phá</span>
                    <span class="block bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 to-blue-500">Kỳ Nghỉ Hoàn Hảo</span>
                </h1>
                <p class="mt-6 max-w-lg text-xl sm:text-2xl lg:text-3xl leading-relaxed text-gray-200">
                    Trải nghiệm đẳng cấp từ những khách sạn tinh tế nhất Việt Nam
                </p>
                <div class="mt-10 flex flex-row justify-start gap-3">
                    <a asp-controller="Find_Room" asp-action="Index"
                       class="bg-gradient-to-r from-cyan-500 to-blue-600 text-white rounded-xl py-5 px-10 text-xl font-medium hover:shadow-lg transition duration-300 flex items-center justify-center">
                        <i class="fas fa-search mr-3"></i> Tìm khách sạn
                    </a>
                    <a asp-controller="Offers" asp-action="Index"
                       class="bg-white/20 backdrop-blur-sm text-white border border-white/30 rounded-xl py-5 px-10 text-xl font-medium hover:bg-white/30 transition duration-300 flex items-center justify-center">
                        <i class="fas fa-percent mr-3"></i> Ưu đãi hôm nay
                    </a>
                </div>
            </div>
        </section>
        <!-- Search Section -->
        <div id="searchBar" class="shadow-2xl -mt-10 sm:-mt-14 mx-auto max-w-full w-[1200px] rounded-2xl p-8 relative z-10 bg-white/95 backdrop-blur-md border border-gray-100">
            <form id="searchForm" action="@Url.Action("Index", "Find_Room")" method="get">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                    <div>
                        <label for="checkin" class="block text-xl font-medium text-gray-700 mb-2">Ngày nhận phòng</label>
                        <div class="relative rounded-lg">
                            <input type="date"
                                   id="checkin"
                                   name="checkin"
                                   onkeydown="return false"
                                   onfocus="this.showPicker()"
                                   class="focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 border border-gray-300 block w-full pl-3 pr-10 py-4 rounded-lg text-gray-700 hover:border-gray-400 transition-all duration-200" />
                        </div>
                    </div>
                    <div>
                        <label for="checkout" class="block text-xl font-medium text-gray-700 mb-2">Ngày trả phòng</label>
                        <div class="relative rounded-lg">
                            <input type="date"
                                   id="checkout"
                                   name="checkout"
                                   onkeydown="return false"
                                   onfocus="this.showPicker()"
                                   class="focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 border border-gray-300 block w-full pl-3 pr-10 py-4 rounded-lg text-gray-700 hover:border-gray-400 transition-all duration-200" />
                        </div>
                    </div>
                    <style>
                        input[type="date"]::-webkit-calendar-picker-indicator {
                            position: absolute;
                            right: 12px;
                            z-index: 10;
                        }
                    </style>
                    <div class="relative z-10">
                        <label for="guests" class="block text-xl font-medium text-gray-700 mb-2">Số người</label>
                        <div class="relative rounded-lg">
                            <button id="guestsBtn"
                                    type="button"
                                    class="focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 border border-gray-300 block w-full px-3 py-4 rounded-lg text-gray-700 bg-white shadow text-left flex items-center justify-between hover:border-gray-400">
                                <span id="guestsSummary" class="truncate max-w-[85%]">
                                    1 Người lớn | 0 Trẻ em
                                </span>
                                <i class="fas fa-user-friends text-black pr-1 pl-2 shrink-0"></i>
                            </button>
                            <div id="guestsDropdown" class="absolute hidden w-full mt-2 bg-white border border-gray-300 rounded-lg shadow-lg z-20 p-4">
                                <div class="mb-4">
                                    <div class="flex justify-between items-center">
                                        <label class="text-3xl font-normal text-gray-700">Người lớn</label>
                                        <div class="flex items-center rounded-lg overflow-hidden border border-gray-300 w-fit">
                                            <button type="button" onclick="updateGuests('adults', -1)"
                                                    class="w-14 h-14 text-2xl bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none">
                                                -
                                            </button>
                                            <input type="number" id="adultsCount" name="adults"
                                                   class="w-20 h-14 text-center text-2xl bg-white text-gray-700 font-normal border-none focus:ring-0 no-spinner"
                                                   value="1" min="1" oninput="updateGuests('adults', 0)">
                                            <button type="button" onclick="updateGuests('adults', 1)"
                                                    class="w-14 h-14 text-2xl bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none">
                                                +
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-4">
                                    <div class="flex justify-between items-center">
                                        <label class="text-3xl font-normal text-gray-700">Trẻ em</label>
                                        <div class="flex items-center rounded-lg overflow-hidden border border-gray-300 w-fit">
                                            <button type="button" onclick="updateGuests('children', -1)"
                                                    class="w-14 h-14 text-2xl bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none">
                                                -
                                            </button>
                                            <input type="number" id="childrenCount" name="children"
                                                   class="w-20 h-14 text-center text-2xl bg-white text-gray-700 font-normal border-none focus:ring-0 no-spinner"
                                                   value="0" min="0" oninput="updateGuests('children', 0)">
                                            <button type="button" onclick="updateGuests('children', 1)"
                                                    class="w-14 h-14 text-2xl bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none">
                                                +
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <button type="button" onclick="closeGuestsDropdown()" class="w-full bg-cyan-600 text-white rounded-lg py-2 text-2xl font-medium hover:bg-cyan-700">DONE</button>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-end h-full">
                        <button type="submit"
                                class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 text-white rounded-lg px-3 pr-10 py-5 text-2xl font-medium hover:bg-cyan-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-cyan-500 transition duration-200 flex justify-center items-center">
                            <i class="fas fa-search mr-2"></i> Tìm kiếm
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <link rel="stylesheet" href="@Url.Content("~/css/PageCSS/SearchSection.css")" />
        <script src="@Url.Content("~/js/PageJS/SearchSection.js")"></script>

        <!-- Phần "Địa Điểm Nổi Bật" -->
        <section class="py-20 bg-gradient-to-b from-gray-50 to-gray-100" alt="phần hình ảnh">
            <div class="mx-auto max-w-full w-[1200px] px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-16">
                    <h2 class="text-4xl md:text-5xl font-bold text-gray-800 mb-6">ĐỊA ĐIỂM NỔI BẬT</h2>
                    <p class="text-gray-600 max-w-5xl mx-auto text-4xl md:text-3xl mt-8">
                        Khám phá những không gian tuyệt đẹp làm nên tên tuổi của khách sạn
                    </p>
                </div>
                <div class="location-carousel-container mx-auto w-[1200px] relative">
                    <div class="location-carousel-wrapper overflow-hidden">
                        <div id="location-carousel" class="location-carousel flex gap-6 transition-transform duration-700 ease-out">
                            @if (Model.BannerImages != null && Model.BannerImages.Any())
                            {
                                var total = Model.BannerImages.Count();
                                var index = 0;
                                foreach (var image in Model.BannerImages)
                                {
                                    <div class="location-card h-96 w-[392px] flex-shrink-0">
                                        <img src="@image.ImageUrl" alt="@image.Title" class="w-full h-full object-cover" loading="lazy">
                                        <div class="card-overlay">
                                            <h3 class="card-title">@image.Title</h3>
                                            <p class="card-subtitle">@image.Description</p>
                                        </div>
                                        <a href="@Url.Action("Details", "Location", new { id = index + 1 })" class="view-more">
                                            <i class="fas fa-arrow-right"></i>
                                        </a>
                                    </div>
                                    index++;
                                }
                            }
                            else
                            {
                                <p>Không có hình ảnh để hiển thị.</p>
                            }
                        </div>
                    </div>

                    <!-- Nút mũi tên trái -->
                    <button id="location-prev-btn" class="carousel-nav-btn prev-btn">
                        <i class="fas fa-chevron-left"></i>
                    </button>

                    <!-- Nút mũi tên phải -->
                    <button id="location-next-btn" class="carousel-nav-btn next-btn">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </section>

        <!-- CSS cho carousel -->
        <style>
            .location-carousel-wrapper {
                overflow: hidden;
                width: 100%;
            }

            .location-carousel {
                display: flex;
                gap: 12px; /* Giữ khoảng cách 6px */
                transition: transform 0.5s ease;
            }

            .nav {
                position: absolute;
                top: 50%;
                transform: translateY(-50%);
                width: 48px;
                height: 48px;
                border-radius: 50%;
                background: white;
                box-shadow: 0 0 8px rgba(0,0,0,0.15);
                border: none;
                cursor: pointer;
                z-index: 10;
            }

            .section-heading {
                font-family: 'Playfair Display', serif;
                letter-spacing: 1px;
                position: relative;
                display: inline-block;
            }

                .section-heading::after {
                    content: "";
                    position: absolute;
                    bottom: -10px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 80px;
                    height: 3px;
                    background: linear-gradient(90deg, #1a56db, #3182ce);
                    border-radius: 3px;
                }

            .location-card {
                position: relative;
                border-radius: 12px;
                overflow: hidden;
                box-shadow: 0 10px 25px rgba(0,0,0,0.1);
                transition: all 0.4s ease;
                cursor: pointer;
                flex: 0 0 auto;
                width: 392px;
                height: 24rem;
            }

                .location-card:hover {
                    
                    box-shadow: 0 15px 35px rgba(0,0,0,0.2);
                }

                .location-card img {
                    transition: transform 0.8s ease;
                }

                .location-card:hover img {
                    transform: scale(1.08);
                }
             


            .card-overlay {
                position: absolute;
                inset: 0;
                background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.2) 60%, rgba(0,0,0,0) 100%);
                display: flex;
                flex-direction: column;
                justify-content: flex-end;
                padding: 1.5rem;
                opacity: 0.9;
                transition: opacity 0.4s ease;
            }

            .location-card:hover .card-overlay {
                opacity: 1;
            }

            .card-title {
                color: white;
                font-weight: 600;
                font-size: 2rem;
                margin-bottom: 0.5rem;
                transform: translateY(20px);
                opacity: 0.8;
                transition: all 0.4s ease;
            }

            .location-card:hover .card-title {
                transform: translateY(0);
                opacity: 1;
            }

            .card-subtitle {
                color: rgba(255,255,255,0.8);
                font-size: 1.5rem;
                max-height: 0;
                overflow: hidden;
                transform: translateY(20px);
                transition: all 0.4s ease 0.1s;
            }

            .location-card:hover .card-subtitle {
                max-height: 60px;
                transform: translateY(0);
            }

            .view-more {
                position: absolute;
                top: 1rem;
                right: 1rem;
                background-color: rgba(255,255,255,0.9);
                color: #1a56db;
                width: 40px;
                height: 40px;
                border-radius: 50%;
                display: flex;
                justify-content: center;
                align-items: center;
                transform: scale(0);
                transition: transform 0.3s ease;
            }

            .location-card:hover .view-more {
                transform: scale(1);
            }

            .carousel-nav-btn {
                position: absolute;
                top: 50%;
                transform: translateY(-50%);
                width: 48px;
                height: 48px;
                border-radius: 50%;
                background-color: rgba(255,255,255,0.95);
                color: #1a56db;
                border: none;
                display: flex;
                justify-content: center;
                align-items: center;
                cursor: pointer;
                z-index: 10;
                box-shadow: 0 0 6px rgba(0,0,0,0.2);
            }

            /* Dùng giá trị âm để đẩy ra ngoài */
            .prev-btn {
                left: -25px;
            }

            .next-btn {
                right: -25px;
            }


            .carousel-nav-btn:hover {
                background-color: #1a56db;
                color: white;
            }



            .location-carousel-container {
                position: relative;
                overflow: hidden;
                width: 1200px;
                margin: 0 auto;
            }

        </style>

        <!-- JavaScript để xử lý carousel -->
        <script>
                  document.addEventListener('DOMContentLoaded', () => {
                const locationCarousel = document.getElementById('location-carousel');
                const locationPrevBtn = document.getElementById('location-prev-btn');
                const locationNextBtn = document.getElementById('location-next-btn');

                const locationItems = locationCarousel.querySelectorAll('.location-card');
                const locationItemWidth = locationItems[0].offsetWidth + 12; // Card width + gap (6px)
                const locationVisibleItems = 3; // Cố định hiển thị 3 ảnh
                let locationCurrentIndex = 0;
                let locationTotalItems = locationItems.length;
                let locationMaxIndex = locationTotalItems - locationVisibleItems;

                // Đặt chiều rộng cho carousel
                locationCarousel.style.width = `${locationTotalItems * locationItemWidth}px`;

                function updateLocationCarousel() {
                    locationCarousel.style.transform = `translateX(${-locationCurrentIndex * locationItemWidth}px)`;
                    locationPrevBtn.style.opacity = locationCurrentIndex === 0 ? '0.5' : '1';
                    locationPrevBtn.style.pointerEvents = locationCurrentIndex === 0 ? 'none' : 'auto';
                    locationNextBtn.style.opacity = locationCurrentIndex === locationMaxIndex ? '0.5' : '1';
                    locationNextBtn.style.pointerEvents = locationCurrentIndex === locationMaxIndex ? 'none' : 'auto';
                }

                function goToLocationSlide(index) {
                    if (index < 0) {
                        locationCurrentIndex = locationTotalItems - locationVisibleItems;
                    } else if (index >= locationTotalItems) {
                        locationCurrentIndex = 0;
                    } else {
                        locationCurrentIndex = index;
                    }
                    updateLocationCarousel();
                }

                locationPrevBtn.addEventListener('click', () => {
                    goToLocationSlide(locationCurrentIndex - 1);
                });

                locationNextBtn.addEventListener('click', () => {
                    goToLocationSlide(locationCurrentIndex + 1);
                });

                // Thêm tính năng vuốt (swipe)
                let touchStartX = 0;
                let touchEndX = 0;

                locationCarousel.addEventListener('touchstart', (e) => {
                    touchStartX = e.changedTouches[0].screenX;
                });

                locationCarousel.addEventListener('touchend', (e) => {
                    touchEndX = e.changedTouches[0].screenX;
                    handleLocationSwipe();
                });

                function handleLocationSwipe() {
                    const swipeThreshold = 50;
                    if (touchEndX < touchStartX - swipeThreshold) {
                        goToLocationSlide(locationCurrentIndex + 1);
                    } else if (touchEndX > touchStartX + swipeThreshold) {
                        goToLocationSlide(locationCurrentIndex - 1);
                    }
                }

                // Khởi tạo
                if (locationTotalItems > 0) {
                    updateLocationCarousel();
                }
            });
        </script>
        <section class="section-container py-20">
            <div class="content-wrapper max-w-[1200px] mx-auto px-6">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">

                    <!-- Left Column - Title and Description -->
                    <div class="lg:col-span-4">
                        <div class="mb-8">
                            <span class="category-badge inline-block px-4 py-2 text-gray-600 text-xs font-semibold uppercase tracking-wider rounded-full">
                                NHÀ HÀNG KHÁCH SẠN
                            </span>
                        </div>

                        <h2 class="text-5xl lg:text-6xl font-black mb-8 text-gray-800 leading-tight tracking-tight">
                            Thành Tựu<br>
                            <span class="gradient-text">Tiêu Biểu</span>
                        </h2>

                        <p class="text-gray-600 text-xl leading-relaxed font-medium">
                            Tự hào với những cột mốc và giải thưởng định hình vị thế của chúng tôi trong ngành khách sạn cao cấp.
                        </p>
                    </div>

                    <!-- Middle Column - Hexagon Awards -->
                    <div class="lg:col-span-5 flex justify-center">
                        <div class="hexagon-group flex items-center">
                            @if (Model.Achivements != null && Model.Achivements.Any())
                            {
                                var index = 0;
                                @foreach (var achivement in Model.Achivements.Take(3))
                                {
                                    <div class="flex flex-col items-center">
                                        <div class="hexagon mb-4" onclick="toggleDescription('desc-@index')">
                                            <div class="hexagon-icon">
                                                <img src="@achivement.ImageLink" alt="@achivement.Name" class="w-4 h-4 object-contain" />
                                            </div>
                                        </div>
                                        @if (achivement.Year > 0)
                                        {
                                            <span class="year-label">@achivement.Year</span>
                                        }
                                        <div id="desc-@index" class="description-box">
                                            @Html.Raw(achivement.Description)
                                        </div>
                                    </div>
                                    @if (index < Model.Achivements.Take(3).Count() - 1)
                                    {
                                        <div class="connector-line mx-3"></div>
                                    }
                                    index++;
                                }
                            }
                            else
                            {
                                <div class="flex flex-col items-center">
                                    <div class="hexagon mb-4">
                                        <div class="hexagon-icon">
                                            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                                            </svg>
                                        </div>
                                    </div>
                                    <span class="year-label">Chưa có</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Right Column - Statistics -->
                    <div class="lg:col-span-3">
                        <div class="space-y-12">
                            <div class="stats-card text-center lg:text-left">
                                <div class="stats-number">10+</div>
                                <div class="stats-label">GIẢI THƯỞNG QUỐC TẾ</div>
                            </div>
                            <div class="stats-card text-center lg:text-left">
                                <div class="stats-number">12</div>
                                <div class="stats-label">NĂM KINH NGHIỆM</div>
                            </div>
                            <div class="stats-card">
                                <div class="stats-number">1000+</div>
                                <div class="stats-label">KHÁCH HÀNG HÀI LÒNG</div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>
        <link rel="stylesheet" href="@Url.Content("~/css/ThanhTuu.css")" />

        <script>
            function toggleDescription(id) {
                const descriptions = document.querySelectorAll('.description-box');
                descriptions.forEach(desc => {
                    if (desc.id === id) {
                        desc.classList.toggle('active');
                    } else {
                        desc.classList.remove('active');
                    }
                });
            }
        </script>




        <section class="mx-auto max-w-full w-[1200px] px-4 sm:px-6 lg:px-8 py-16">
            <div class="text-center mb-12">
                <h2 class="text-4xl md:text-5xl font-bold text-gray-800 mb-6">TÙY CHỌN LƯU TRÚ</h2>
                <p class="text-gray-600 max-w-5xl mx-auto text-4xl md:text-3xl mt-8">Chọn từ danh sách các phòng và suite được trang bị sang trọng của chúng tôi</p>
            </div>
            <div class="room-carousel-container mx-auto w-[1200px] relative">
                <div class="room-carousel-wrapper overflow-hidden">
                    <div id="room-carousel" class="room-carousel flex gap-8 transition-transform duration-700 ease-out">
                        @if (Model.Rooms != null && Model.Rooms.Any())
                        {
                            @foreach (var room in Model.Rooms)
                            {
                                <div class="room-card bg-white rounded-lg shadow-md overflow-hidden flex-shrink-0 w-[392px]" alt="@room.RoomType.TypeName">
                                    <div class="relative w-full h-full">
                                        <img src="@room.ImageUrl" alt="@room.RoomType.TypeName" class="w-full h-full object-cover" loading="lazy">
                                        <div class="absolute top-4 left-4 text-white px-2 py-1">
