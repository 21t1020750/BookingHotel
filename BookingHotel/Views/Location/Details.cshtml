@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewBag.Title = "Địa điểm nổi bật";
}
<script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#f0f9ff',
              100: '#e0f2fe',
              200: '#bae6fd',
              300: '#7dd3fc',
              400: '#38bdf8',
              500: '#0ea5e9',
              600: '#0284c7',
              700: '#0369a1',
              800: '#075985',
              900: '#0c4a6e',
            }
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
        }
      }
    }
</script>

<!-- css-->
<link href="~/css/Details.css" rel="stylesheet" />



<!-- Main Content -->
<div class="main-container">
    <!-- Gallery Section -->
    <div class="gallery-section">
        <!-- Featured Gallery -->
        <div class="gallery-container">
            <!-- Featured images -->
            <div class="gallery-item featured row-span-2 relative">
                <div class="featured-label"><i class="fas fa-crown mr-1"></i> Nổi bật</div>
                <div class="image-overlay"></div>
                <img src="https://images.unsplash.com/photo-1647105604081-a532d33fd003?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3MzY5OTh8MHwxfHNlYXJjaHwzfHxNYWluJTIwcm9vbXxlbnwwfHx8fDE3NDc2NDYxMzd8MA&ixlib=rb-4.1.0&q=85" alt="Phòng chính">
            </div>
            <div class="gallery-item">
                <div class="image-overlay"></div>
                <img src="https://images.unsplash.com/photo-1541922633525-b39c46b1b219?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3MzY5OTh8MHwxfHNlYXJjaHwxfHxSb29mdG9wJTIwcG9vbHxlbnwwfHx8fDE3NDc2NDYxMzd8MA&ixlib=rb-4.1.0&q=85" alt="Hồ bơi trên sân thượng">
            </div>
            <div class="gallery-item">
                <div class="image-overlay"></div>
                <img src="https://images.unsplash.com/photo-1617293672222-9a799fe55473?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3MzY5OTh8MHwxfHNlYXJjaHwyfHxIb3RlbCUyMGJhbGNvbnl8ZW58MHx8fHwxNzQ3NjQ2MTM3fDA&ixlib=rb-4.1.0&q=85" alt="Ban công khách sạn">
            </div>
        </div>

        <!-- Thumbnails -->
        <div class="thumbnail-row">
            <div class="gallery-item">
                <div class="image-overlay"></div>
                <img src="https://images.unsplash.com/photo-1583847268964-b28dc8f51f92?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3MzY5OTh8MHwxfHNlYXJjaHwyfHxSb29tJTIwaW50ZXJpb3J8ZW58MHx8fHwxNzQ3NjQ2MTM3fDA&ixlib=rb-4.1.0&q=85" alt="Nội thất phòng">
            </div>
            <div class="gallery-item">
                <div class="image-overlay"></div>
                <img src="https://images.unsplash.com/photo-1671497601148-bc2375e45a74?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3MzY5OTh8MHwxfHNlYXJjaHwxfHxCYXRocm9vbSUyMHZpZXd8ZW58MHx8fHwxNzQ3NjQ2MTM3fDA&ixlib=rb-4.1.0&q=85" alt="Tầm nhìn phòng tắm">
            </div>
            <div class="gallery-item">
                <div class="image-overlay"></div>
                <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3MzY5OTh8MHwxfHNlYXJjaHwxfHxDaXR5JTIwdmlld3xlbnwwfHx8fDE3NDc2NDYxMzd8MA&ixlib=rb-4.1.0&q=85" alt="Tầm nhìn thành phố">
            </div>
            <div class="gallery-item">
                <div class="image-overlay"></div>
                <img src="https://images.unsplash.com/photo-1614846384571-1e31322ed3a9?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3MzY5OTh8MHwxfHNlYXJjaHwyfHxIb3RlbCUyMGV4dGVyaW9yfGVufDB8fHx8MTc0NzY0NjEzN3ww&ixlib=rb-4.1.0&q=85" alt="Ngoại thất khách sạn" loading="lazy">
            </div>
            <div class="gallery-item relative">
                <div class="image-overlay"></div>
                <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3MzY5OTh8MHwxfHNlYXJjaHwxfHxIb3RlbCUyMGJlZHxlbnwwfHx8fDE3NDc2NDYxMzd8MA&ixlib=rb-4.1.0&q=85" alt="Giường khách sạn">
                <div class="more-photos"><i class="fas fa-images mr-2"></i> +37 ảnh</div>
            </div>
        </div>

        <!-- Info below gallery -->
        <div class="mt-8">
            <div class="flex flex-wrap gap-2 mb-5">
                <div class="badge"><i class="fas fa-medal"></i> Phòng sang trọng</div>
                <div class="badge"><i class="fas fa-water"></i> Tầm nhìn biển</div>
                <div class="badge"><i class="fas fa-utensils"></i> Bữa sáng miễn phí</div>
                <div class="badge"><i class="fas fa-concierge-bell"></i> Dịch vụ 24/7</div>
            </div>

            <div class="info-card mb-8">
                <div class="heading-with-line">
                    <h2>Mô Tả</h2>
                    <div class="line"></div>
                </div>
                <p class="text-gray-700 leading-relaxed">
                    Trải nghiệm sự thoải mái tuyệt đối tại các phòng suite hướng biển cao cấp của chúng tôi. Mỗi phòng đều có cửa sổ từ sàn đến trần, ban công riêng và các tiện nghi cao cấp được thiết kế để đảm bảo kỳ nghỉ của bạn thật sự đáng nhớ. Khu nghỉ dưỡng của chúng tôi kết hợp giữa sự sang trọng hiện đại và vẻ đẹp tự nhiên của cảnh quan xung quanh.
                </p>
                <p class="text-gray-700 leading-relaxed mt-4">
                    Với vị trí đắc địa ven biển, du khách có thể tận hưởng không gian riêng tư tuyệt đối cùng những hoạt động giải trí đa dạng từ thể thao nước đến các liệu pháp spa độc đáo. Nhà hàng cao cấp trong khu nghỉ dưỡng phục vụ các món ăn đặc sản địa phương và quốc tế, hứa hẹn sẽ làm hài lòng cả những thực khách khó tính nhất.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
                <div class="info-card h-full">
                    <div class="heading-with-line">
                        <h2>Tiện Nghi Phòng</h2>
                        <div class="line"></div>
                    </div>
                    <ul class="space-y-4 mt-4">
                        <li class="flex items-center amenity-item">
                            <span class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center mr-3 shadow-sm">
                                <i class="fas fa-wifi text-primary-700 amenity-icon"></i>
                            </span>
                            <span class="text-sm">WiFi tốc độ cao miễn phí</span>
                        </li>
                        <li class="flex items-center amenity-item">
                            <span class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center mr-3 shadow-sm">
                                <i class="fas fa-tv text-primary-700 amenity-icon"></i>
                            </span>
                            <span class="text-sm">Smart TV 55" với Netflix</span>
                        </li>
                        <li class="flex items-center amenity-item">
                            <span class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center mr-3 shadow-sm">
                                <i class="fas fa-snowflake text-primary-700 amenity-icon"></i>
                            </span>
                            <span class="text-sm">Điều hòa nhiệt độ trung tâm</span>
                        </li>
                        <li class="flex items-center amenity-item">
                            <span class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center mr-3 shadow-sm">
                                <i class="fas fa-coffee text-primary-700 amenity-icon"></i>
                            </span>
                            <span class="text-sm">Máy pha cà phê Nespresso</span>
                        </li>
                        <li class="flex items-center amenity-item">
                            <span class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center mr-3 shadow-sm">
                                <i class="fas fa-bath text-primary-700 amenity-icon"></i>
                            </span>
                            <span class="text-sm">Bồn tắm thủy lực cao cấp</span>
                        </li>
                        <li class="flex items-center amenity-item">
                            <span class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center mr-3 shadow-sm">
                                <i class="fas fa-door-closed text-primary-700 amenity-icon"></i>
                            </span>
                            <span class="text-sm">Ban công riêng với tầm nhìn biển</span>
                        </li>
                    </ul>
                </div>

                <div class="info-card h-full">
                    <div class="heading-with-line">
                        <h2>Tiện Ích Khu Nghỉ Dưỡng</h2>
                        <div class="line"></div>
                    </div>
                    <ul class="space-y-4 mt-4">
                        <li class="flex items-center amenity-item">
                            <span class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center mr-3 shadow-sm">
                                <i class="fas fa-swimming-pool text-primary-700 amenity-icon"></i>
                            </span>
                            <span class="text-sm">Hồ bơi vô cực hướng biển</span>
                        </li>
                        <li class="flex items-center amenity-item">
                            <span class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center mr-3 shadow-sm">
                                <i class="fas fa-utensils text-primary-700 amenity-icon"></i>
                            </span>
                            <span class="text-sm">Nhà hàng cao cấp 5 sao</span>
                        </li>
                        <li class="flex items-center amenity-item">
                            <span class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center mr-3 shadow-sm">
                                <i class="fas fa-spa text-primary-700 amenity-icon"></i>
                            </span>
                            <span class="text-sm">Spa và liệu pháp thư giãn</span>
                        </li>
                        <li class="flex items-center amenity-item">
                            <span class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center mr-3 shadow-sm">
                                <i class="fas fa-dumbbell text-primary-700 amenity-icon"></i>
                            </span>
                            <span class="text-sm">Phòng tập gym hiện đại</span>
                        </li>
                        <li class="flex items-center amenity-item">
                            <span class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center mr-3 shadow-sm">
                                <i class="fas fa-cocktail text-primary-700 amenity-icon"></i>
                            </span>
                            <span class="text-sm">Quầy bar bên hồ bơi</span>
                        </li>
                        <li class="flex items-center amenity-item">
                            <span class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center mr-3 shadow-sm">
                                <i class="fas fa-volleyball-ball text-primary-700 amenity-icon"></i>
                            </span>
                            <span class="text-sm">Các hoạt động thể thao nước</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Property Info and Description -->
    <div class="property-info-section">
        <!-- Booking Card -->
        <div class="booking-card info-card">
            <h3 class="text-lg font-semibold mb-2">Đặt Ngay, Tiết Kiệm 15%</h3>
            <div class="price-tag">
                <span class="currency">đ</span>4,500,000<span class="per-night">/đêm</span>
            </div>

            <div class="flex items-center text-sm text-gray-600 mb-5">
                <i class="fas fa-calendar-alt text-primary-600 mr-2"></i>
                20/05 - 25/05, 2025 (5 đêm)
            </div>

            <div class="mb-6 space-y-3">
                <div class="flex justify-between text-sm">
                    <span>Giá gốc (5 đêm)</span>
                    <span class="font-medium">đ25,000,000</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span>Giảm giá sớm (-15%)</span>
                    <span class="font-medium text-green-600">-đ3,750,000</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span>Thuế và phí</span>
                    <span class="font-medium">đ2,125,000</span>
                </div>
                <div class="border-t pt-3 flex justify-between font-semibold">
                    <span>Tổng cộng</span>
                    <span class="text-primary-700">đ23,375,000</span>
                </div>
            </div>

            <button class="w-full py-4 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors font-semibold book-button flex items-center justify-center">
                <i class="fas fa-calendar-check mr-2"></i> Đặt Ngay
            </button>

            <div class="mt-4 text-xs text-center text-gray-500">
                Bạn chưa bị trừ tiền - Miễn phí hủy trước 7 ngày
            </div>
        </div>
    </div>
</div>

