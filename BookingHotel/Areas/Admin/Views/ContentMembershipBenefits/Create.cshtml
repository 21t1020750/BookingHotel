@model BookingHotel.Models.Content_MembershipBenefit

<h2>Tạo Lợi Ích Hội Viên</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Benefit" class="control-label"></label>
        <textarea asp-for="Benefit" class="form-control" name="Benefit"></textarea>
        <span asp-validation-for="Benefit" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Tạo" class="btn btn-primary" />
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}