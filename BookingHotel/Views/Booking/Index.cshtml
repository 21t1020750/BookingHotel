@model BookingHotel.Models.BookingViewModel
@{
    ViewData["Title"] = "Đặt phòng";
}

<body class="bg-gray-50" alt="booking page">
    <main class="py-8">
        <div class="container mx-auto px-4 max-w-[1200px]">
            <!-- Progress Steps -->
            <div class="flex justify-between items-center mb-12">
                <div class="flex flex-col items-center">
                    <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center text-white font-bold mb-2">1</div>
                    <span class="text-sm font-medium text-blue-600">Chọn phòng</span>
                </div>
                <div class="h-1 bg-blue-600 flex-grow mx-2"></div>
                <div class="flex flex-col items-center">
                    <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center text-white font-bold mb-2">2</div>
                    <span class="text-sm font-medium text-blue-600">Xác nhận</span>
                </div>
                <div class="h-1 @(Model.IsBookingSuccessful ? "bg-blue-600" : "bg-gray-300") flex-grow mx-2" id="step3-line"></div>
                <div class="flex flex-col items-center">
                    <div class="w-10 h-10 @(Model.IsBookingSuccessful ? "bg-blue-600" : "bg-gray-300") rounded-full flex items-center justify-center text-white font-bold mb-2" id="step3-circle">3</div>
                    <span class="text-sm font-medium @(Model.IsBookingSuccessful ? "text-blue-600" : "text-gray-500")" id="step3-text">Hoàn tất</span>
                </div>
            </div>

            <!-- Confirmation Section -->
            <form asp-action="Confirm" method="post" class="@(Model.IsBookingSuccessful ? "hidden" : "")" id="confirmation-section">
                @Html.HiddenFor(m => m.RoomId)
                @Html.HiddenFor(m => m.RoomNumber)
                @Html.HiddenFor(m => m.Price)
                @Html.HiddenFor(m => m.Checkin)
                @Html.HiddenFor(m => m.Checkout)
                @Html.HiddenFor(m => m.Adults)
                @Html.HiddenFor(m => m.Children)
                @Html.HiddenFor(m => m.Rooms)
                <div class="flex flex-col lg:flex-row gap-8">
                    <!-- Booking Summary -->
                    <div class="lg:w-2/3">
                        <div class="bg-white rounded-xl shadow-lg p-6 mb-6 summary-card">
                            <h2 class="text-2xl font-bold text-gray-800 mb-6">Xác nhận đặt phòng</h2>

                            <!-- Hotel Info -->
                            <div class="border-b border-gray-200 pb-6 mb-6">
                                <h3 class="text-xl font-bold text-gray-800 mb-2">Lavela Hue Hotel</h3>
                                <div class="flex items-center mb-3">
                                    <i class="fas fa-star text-yellow-400 mr-1"></i>
                                    <i class="fas fa-star text-yellow-400 mr-1"></i>
                                    <i class="fas fa-star text-yellow-400 mr-1"></i>
                                    <i class="fas fa-star text-yellow-400 mr-1"></i>
                                    <i class="fas fa-star text-yellow-400 mr-1"></i>
                                    <span class="text-sm text-gray-500 ml-2">(128 đánh giá)</span>
                                </div>
                                <p class="text-gray-600">
                                    <i class="fas fa-map-marker-alt text-gray-400 mr-2"></i> 123 Imperial Street, Huế, Việt Nam
                                </p>
                            </div>

                            <!-- Booking Details -->
                            <div class="border-b border-gray-200 pb-6 mb-6">
                                <h3 class="text-lg font-bold text-gray-800 mb-4">Chi tiết đặt phòng</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div>
                                        <h4 class="font-medium text-gray-700 mb-2">Ngày đến</h4>
                                        <p class="text-gray-800">@Model.Checkin.ToString("dddd, dd tháng MM năm yyyy", new System.Globalization.CultureInfo("vi-VN"))</p>
                                    </div>
                                    <div>
                                        <h4 class="font-medium text-gray-700 mb-2">Ngày đi</h4>
                                        <p class="text-gray-800">@Model.Checkout.ToString("dddd, dd tháng MM năm yyyy", new System.Globalization.CultureInfo("vi-VN"))</p>
                                    </div>
                                    <div>
                                        <h4 class="font-medium text-gray-700 mb-2">Số đêm</h4>
                                        <p class="text-gray-800">@((Model.Checkout - Model.Checkin).Days) đêm</p>
                                    </div>
                                    <div>
                                        <h4 class="font-medium text-gray-700 mb-2">Số phòng</h4>
                                        <p class="text-gray-800">@Model.Rooms phòng</p>
                                    </div>
                                    <div>
                                        <h4 class="font-medium text-gray-700 mb-2">Người lớn</h4>
                                        <p class="text-gray-800">@Model.Adults người</p>
                                    </div>
                                    <div>
                                        <h4 class="font-medium text-gray-700 mb-2">Trẻ em</h4>
                                        <p class="text-gray-800">@(Model.Children > 0 ? $"{Model.Children} trẻ em" : "Không có")</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Room Details -->
                            <div class="border-b border-gray-200 pb-6 mb-6">
                                <h3 class="text-lg font-bold text-gray-800 mb-4">Phòng đã chọn</h3>

                                @foreach (var room in Model.RoomInfo)
                                {
                                    <div class="bg-gray-50 rounded-lg p-4 mb-4">
                                        <div class="flex justify-between items-start mb-3">
                                            <div>
                                                <h4 class="font-bold text-gray-800">Phòng @room.RoomNumber</h4>
                                                <p class="text-sm text-gray-600">@Html.Raw(room.Description)</p>
                                            </div>
                                            <div class="text-right">
                                                <p class="text-gray-800 font-bold">@room.Price.ToString("N0") VND</p>
                                                <p class="text-xs text-gray-500">@((Model.Checkout - Model.Checkin).Days) đêm, @(Model.Adults + Model.Children) người</p>
                                            </div>
                                        </div>

                                        <div class="pl-4 border-l-2 border-blue-200">
                                            <div class="flex justify-between items-center py-2">
                                                <span class="text-sm text-gray-700">
                                                    Giá phòng (1 phòng × @((Model.Checkout - Model.Checkin).Days) đêm)
                                                </span>
                                                <span class="text-sm text-gray-700">
                                                    @((room.Price * (Model.Checkout - Model.Checkin).Days).ToString("N0")) VND
                                                </span>
                                            </div>
                                            <div class="flex justify-between items-center py-2">
                                                <span class="text-sm text-gray-700">Thuế & phí (12%)</span>
                                                <span class="text-sm text-gray-700">
                                                    @((room.Price * (Model.Checkout - Model.Checkin).Days * 0.12m).ToString("N0")) VND
                                                </span>
                                            </div>
                                            <div class="flex justify-between items-center pt-2 border-t border-gray-200 mt-2">
                                                <span class="font-medium text-gray-800">Tổng cộng</span>
                                                <span class="font-bold text-lg text-blue-600">
                                                    @((room.Price * (Model.Checkout - Model.Checkin).Days * 1.12m).ToString("N0")) VND
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <h3>Dịch vụ bổ sung</h3>
                            @foreach (var service in Model.AllServices)
                            {
                                <div>
                                    <label>
                                        <input type="checkbox" class="service-checkbox" data-price="@service.Price" name="SelectedServiceIds" value="@service.ServiceID" />
                                        @service.ServiceName (@service.Price.ToString("N0") đ)
                                    </label>
                                </div>
                            }

                            <hr />
                            <p><strong>Tổng tiền tạm tính: </strong><span id="totalPrice">@Model.Price.ToString("N0")</span> đ</p>

                            <!-- Hidden để post lên -->
                            <input type="hidden" id="hiddenTotalPrice" name="TotalPrice" value="@Model.Price" />


                            <!-- Special Requests -->
                            <div class="mb-6">
                                <h3 class="text-lg font-bold text-gray-800 mb-4">Yêu cầu đặc biệt</h3>
                                <textarea class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" rows="3" placeholder="Vui lòng nhập yêu cầu đặc biệt nếu có..."></textarea>
                            </div>
                        </div>

                        <!-- Payment Method -->
                        <div class="bg-white rounded-xl shadow-lg p-6 mb-6 summary-card">
                            <h2 class="text-xl font-bold text-gray-800 mb-6">Phương thức thanh toán</h2>
                            <div class="space-y-4">
                                <div class="flex items-center">
                                    <input type="radio" id="credit-card" name="payment" class="form-radio h-4 w-4 text-blue-600" value="credit-card">
                                    <label for="credit-card" class="ml-2 text-gray-700 font-medium">Thẻ tín dụng/Thẻ ghi nợ</label>
                                </div>
                                <div class="border border-gray-200 rounded-lg p-4 bg-gray-50">
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-gray-700 mb-2">Số thẻ</label>
                                            <input type="text" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="1234 5678 9012 3456">
                                        </div>
                                        <div>
                                            <label class="block text-gray-700 mb-2">Tên trên thẻ</label>
                                            <input type="text" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="NGUYEN VAN A">
                                        </div>
                                        <div>
                                            <label class="block text-gray-700 mb-2">Ngày hết hạn</label>
                                            <input type="text" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="MM/YY">
                                        </div>
                                        <div>
                                            <label class="block text-gray-700 mb-2">Mã CVV</label>
                                            <input type="text" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="123">
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center mt-4">
                                    <input type="checkbox" id="save-card" class="form-checkbox h-4 w-4 text-blue-600">
                                    <label for="save-card" class="ml-2 text-gray-700">Lưu thẻ cho lần thanh toán sau</label>
                                </div>
                                <div class="flex items-center mt-4">
                                    <input type="radio" id="pay-later" name="payment" class="form-radio h-4 w-4 text-blue-600" value="pay-later">
                                    <label for="pay-later" class="ml-2 text-gray-700 font-medium">Thanh toán tại khách sạn</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Booking Summary Card -->
                    <div class="lg:w-1/3">
                        <div class="bg-white rounded-xl shadow-lg p-6 sticky top-6 summary-card">
                            <h2 class="text-xl font-bold text-gray-800 mb-6">Tóm tắt đặt phòng</h2>
                            <div class="mb-6">
                                <div class="flex justify-between items-center mb-2">
                                    <span class="text-gray-700">@Model.Rooms phòng × @((Model.Checkout - Model.Checkin).Days) đêm</span>
                                    <span class="text-gray-700">@((Model.Price * Model.Rooms * (Model.Checkout - Model.Checkin).Days).ToString("N0")) VND</span>
                                </div>
                                <div class="flex justify-between items-center mb-2">
                                    <span class="text-gray-700">Thuế & phí (12%)</span>
                                    <span class="text-gray-700">@((Model.Price * Model.Rooms * (Model.Checkout - Model.Checkin).Days * 0.12m).ToString("N0")) VND</span>
                                </div>
                                <div class="flex justify-between items-center pt-4 mt-4 border-t border-gray-200">
                                    <span class="font-bold text-gray-800">Tổng cộng</span>
                                    <span class="font-bold text-xl text-blue-600">@((Model.Price * Model.Rooms * (Model.Checkout - Model.Checkin).Days * (1 + 0.12m)).ToString("N0")) VND</span>
                                </div>
                            </div>
                            <div class="mb-6">
                                <label class="flex items-center">
                                    <input type="checkbox" class="form-checkbox h-4 w-4 text-blue-600" required>
                                    <span class="ml-2 text-sm text-gray-700">Tôi đồng ý với <a href="#" class="text-blue-600 hover:underline">Điều khoản & Điều kiện</a> và <a href="#" class="text-blue-600 hover:underline">Chính sách hủy phòng</a></span>
                                </label>
                            </div>
                            <button id="confirmBooking" type="submit" class="w-full py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium text-lg">
                                Xác nhận đặt phòng
                            </button>
                            <p class="text-xs text-gray-500 mt-4">
                                <i class="fas fa-lock text-gray-400 mr-1"></i> Thông tin thanh toán của bạn được bảo mật
                            </p>
                        </div>
                    </div>
                </div>
            </form>

            <!-- Success Section -->
            <div id="success-section" class="@(Model.IsBookingSuccessful ? "" : "hidden")">
                <div class="bg-white rounded-xl shadow-lg p-8 max-w-3xl mx-auto">
                    <div class="text-center mb-8">
                        <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                            <i class="fas fa-check-circle text-4xl text-green-500"></i>
                        </div>
                        <h1 class="text-2xl font-bold text-gray-800 mb-2">Đặt phòng thành công!</h1>
                        <p class="text-gray-600">Cảm ơn bạn đã đặt phòng tại Lavela Hue Hotel.</p>
                    </div>

                    <div class="border border-gray-200 rounded-lg p-6 mb-8">
                        <h2 class="text-xl font-bold text-gray-800 mb-4">Thông tin đặt phòng</h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                            <div>
                                <h3 class="text-lg font-semibold text-gray-700 mb-2">Mã đặt phòng</h3>
                                <p class="text-blue-600 font-medium">@(Model.BookingCode ?? "Chưa tạo mã")</p>
                            </div>
                            <div>
                                <h3 class="text-lg font-semibold text-gray-700 mb-2">Ngày đặt</h3>
                                <p>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                        </div>
                        <div class="space-y-4">
                            <div class="flex justify-between">
                                <span class="text-gray-600">Khách sạn:</span>
                                <span class="font-medium">Lavela Hue Hotel</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-600">Loại phòng:</span>
                                <span class="font-medium">@Model.RoomNumber</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-600">Ngày nhận phòng:</span>
                                <span class="font-medium">@Model.Checkin.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-600">Ngày trả phòng:</span>
                                <span class="font-medium">@Model.Checkout.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-600">Số đêm:</span>
                                <span class="font-medium">@((Model.Checkout - Model.Checkin).Days) đêm</span>
                            </div>
                            <div class="flex justify-between pt-4 border-t border-gray-200">
                                <span class="text-gray-600 font-semibold">Tổng thanh toán:</span>
                                <span class="text-blue-600 font-bold text-lg">@((Model.Price * Model.Rooms * (Model.Checkout - Model.Checkin).Days * (1 + 0.12m)).ToString("N0")) VND</span>
                            </div>
                        </div>
                    </div>

                    <div class="bg-blue-50 rounded-lg p-4 mb-6">
                        <div class="flex items-start">
                            <i class="fas fa-info-circle text-blue-500 mt-1 mr-3"></i>
                            <div>
                                <h3 class="font-semibold text-blue-800 mb-1">Thông tin quan trọng</h3>
                                <p class="text-gray-700 text-sm">
                                    Chúng tôi đã gửi thông tin đặt phòng đến email của bạn. Vui lòng kiểm tra hộp thư đến hoặc thư mục spam.
                                    Khi đến nhận phòng, vui lòng xuất trình CMND/CCCD và mã đặt phòng này.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <button class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium">
                            <i class="fas fa-download mr-2"></i> Tải hoá đơn PDF
                        </button>
                        <button class="px-6 py-3 bg-white border border-blue-600 text-blue-600 rounded-lg hover:bg-blue-50 transition font-medium" onclick="window.location.href='/'">
                            <i class="fas fa-home mr-2"></i> Về trang chủ
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const confirmButton = document.getElementById('confirmBooking');
            const paymentMethods = document.getElementsByName('payment');
            const termsCheckbox = document.querySelector('input[type="checkbox"][required]');

            if (confirmButton) {
                confirmButton.addEventListener('click', function(e) {
                    // Kiểm tra phương thức thanh toán
                    let paymentSelected = false;
                    for (const method of paymentMethods) {
                        if (method.checked) {
                            paymentSelected = true;
                            break;
                        }
                    }

                    if (!paymentSelected) {
                        e.preventDefault();
                        alert('Vui lòng chọn một phương thức thanh toán.');
                        return;
                    }

                    // Kiểm tra đồng ý điều khoản
                    if (!termsCheckbox.checked) {
                        e.preventDefault();
                        alert('Vui lòng đồng ý với Điều khoản & Điều kiện và Chính sách hủy phòng.');
                        return;
                    }

                    // Form sẽ được gửi, server sẽ xử lý và trả về View với trạng thái cập nhật
                });
            }

            // Cuộn lên đầu trang nếu ở success section
            if (@Model.IsBookingSuccessful.ToString().ToLower() === 'true') {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        });

            document.addEventListener("DOMContentLoaded", function () {
            const checkboxes = document.querySelectorAll('.service-checkbox');
            const totalPriceSpan = document.getElementById('totalPrice');
            const hiddenTotal = document.getElementById('hiddenTotalPrice');

            let basePrice = parseFloat(hiddenTotal.value); // Giá phòng đã tính sẵn
            let currentTotal = basePrice;

            checkboxes.forEach(cb => {
                cb.addEventListener('change', function () {
                    const price = parseFloat(this.getAttribute('data-price'));

                    if (this.checked) {
                        currentTotal += price;
                    } else {
                        currentTotal -= price;
                    }

                    totalPriceSpan.textContent = currentTotal.toLocaleString('vi-VN');
                    hiddenTotal.value = currentTotal;
                });
            });
        });

    </script>
</body>
