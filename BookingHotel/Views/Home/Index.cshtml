@model BookingHotel.Models.HomeViewModel
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewBag.Title = "Trang chủ";
}
<body class="bg-gray-50" alt="khách sạn sang trọng">
    <main>
        <!-- Hero Section với Background Slider -->
        <section class="relative text-white py-24 min-h-[70vh] flex items-center overflow-hidden">
            <!-- Background slider với hiệu ứng gradient overlay -->
            <div class="absolute inset-0 overflow-hidden z-0">
                <div id="slider" class="w-full h-full flex transition-transform duration-1000">
                    <div class="w-full flex-shrink-0 relative">
                        <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c" class="w-full h-full object-cover" />
                        <div class="absolute inset-0 bg-gradient-to-r from-black/60 to-transparent"></div>
                    </div>
                    <div class="w-full flex-shrink-0 relative">
                        <img src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb" class="w-full h-full object-cover" />
                        <div class="absolute inset-0 bg-gradient-to-r from-black/60 to-transparent"></div>
                    </div>
                    <div class="w-full flex-shrink-0 relative">
                        <img src="https://images.unsplash.com/photo-1593297237733-184d3ff53d80?q=80&w=2072&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" class="w-full h-full object-cover" />
                        <div class="absolute inset-0 bg-gradient-to-r from-black/60 to-transparent"></div>
                    </div>
                    <div class="w-full flex-shrink-0 relative">
                        <img src="https://du-lich.chudu24.com/f/m/2304/24/khach-san-hoang-hon-tim-boutique-phu-quoc-2.jpg?h=532&w=800" class="w-full h-full object-cover" />
                        <div class="absolute inset-0 bg-gradient-to-r from-black/60 to-transparent"></div>
                    </div>
                </div>
            </div>
            <div class="pagination absolute z-10">
            </div>
            <!-- CSS  -->
            <link rel="stylesheet" href="~/css/PageCSS/background.css" />
            <!-- JavaScript -->
            <script src="~/js/PageJS/background.js"></script>

            <div class="container relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center md:text-left">
                <h1 class="text-5xl sm:text-6xl xl:text-7xl font-extrabold tracking-tight leading-tight mb-6 font-['Inter']">
                    <span class="block text-white">Khám Phá</span>
                    <span class="block bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 to-blue-500">Kỳ Nghỉ Hoàn Hảo</span>
                </h1>
                <p class="mt-6 max-w-lg text-xl sm:text-2xl lg:text-3xl leading-relaxed text-gray-200">
                    Trải nghiệm đẳng cấp từ những khách sạn tinh tế nhất Việt Nam
                </p>
                <div class="mt-10 flex flex-row justify-start gap-3">
                    <a asp-controller="Find_Room" asp-action="Index"
                       class="bg-gradient-to-r from-cyan-500 to-blue-600 text-white rounded-xl py-5 px-10 text-xl font-medium hover:shadow-lg transition duration-300 flex items-center justify-center">
                        <i class="fas fa-search mr-3"></i> Tìm khách sạn
                    </a>
                    <a asp-controller="Offers" asp-action="Index"
                       class="bg-white/20 backdrop-blur-sm text-white border border-white/30 rounded-xl py-5 px-10 text-xl font-medium hover:bg-white/30 transition duration-300 flex items-center justify-center">
                        <i class="fas fa-percent mr-3"></i> Ưu đãi hôm nay
                    </a>
                </div>
            </div>
        </section>
        <!-- Search Section -->
        <div id="searchBar" class="shadow-2xl -mt-10 sm:-mt-14 mx-auto max-w-full w-[1200px] rounded-2xl p-8 relative z-10 bg-white/95 backdrop-blur-md border border-gray-100">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <div>
                    <label for="checkin" class="block text-xl font-medium text-gray-700 mb-2">Ngày nhận phòng</label>
                    <div class="relative rounded-lg">
                        <input type="date"
                               id="checkin"
                               onkeydown="return false"
                               onfocus="this.showPicker()"
                               class="focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 border border-gray-300 block w-full pl-3 pr-10 py-4 rounded-lg text-gray-700 hover:border-gray-400 transition-all duration-200" />
                    </div>
                </div>
                <div>
                    <label for="checkout" class="block text-xl font-medium text-gray-700 mb-2">Ngày trả phòng</label>
                    <div class="relative rounded-lg">
                        <input type="date"
                               id="checkout"
                               onkeydown="return false"
                               onfocus="this.showPicker()"
                               class="focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 border border-gray-300 block w-full pl-3 pr-10 py-4 rounded-lg text-gray-700 hover:border-gray-400 transition-all duration-200" />
                    </div>
                </div>             
                <style>
                    input[type="date"]::-webkit-calendar-picker-indicator {
                        position: absolute;
                        right: 12px;
                        z-index: 10;
                    }
                </style>
                <div>
                    <label for="guests" class="block text-lg font-medium text-gray-700 mb-2">Số người & phòng</label>
                    <div class="relative rounded-lg">
                        <button id="guestsBtn"
                                class="focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 border border-gray-300 block w-full pl-3 pr- py-4 rounded-lg text-gray-700 transition-all duration-200 text-left flex items-center justify-between hover:border-gray-400">
                            <div class="flex items-center relative w-full">
                                <i class="text-gray-400 absolute left-0 ml-1"></i>
                                <span id="guestsSummary" class="truncate">
                                    1 Người lớn | 0 Trẻ em | 1 Phòng
                                </span>
                            </div>
                            <i class="fas fa-user-friends text-black ml-auto pr-2"></i>
                        </button>


                        <div id="guestsDropdown" class="absolute hidden w-full mt-2 bg-white border border-gray-300 rounded-lg shadow-lg z-20 p-4">
                            <div class="mb-4">
                                <div class="flex justify-between items-center">
                                    <label class="text-3xl font-normal text-gray-700">Người lớn</label>
                                    <div class="flex items-center rounded-lg overflow-hidden border border-gray-300 w-fit">
                                        <button onclick="updateGuests('adults', -1)"
                                                class="w-14 h-14 text-2xl bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none">
                                            -
                                        </button>
                                        <input type="number" id="adultsCount"
                                               class="w-20 h-14 text-center text-2xl bg-white text-gray-700 font-normal border-none focus:ring-0 no-spinner"
                                               value="1" min="1" oninput="updateGuests('adults', 0)">
                                        <button onclick="updateGuests('adults', 1)"
                                                class="w-14 h-14 text-2xl bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none">
                                            +
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-4">
                                <div class="flex justify-between items-center">
                                    <label class="text-3xl font-normal text-gray-700">Người lớn</label>
                                    <div class="flex items-center rounded-lg overflow-hidden border border-gray-300 w-fit">
                                        <button onclick="updateGuests('children', -1)"
                                                class="w-14 h-14 text-2xl bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none">
                                            -
                                        </button>
                                        <input type="number" id="childrenCount"
                                               class="w-20 h-14 text-center text-2xl bg-white text-gray-700 font-normal border-none focus:ring-0 no-spinner"
                                               value="1" min="1" oninput="updateGuests('children', 0)">
                                        <button onclick="updateGuests('children', 1)"
                                                class="w-14 h-14 text-2xl bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none">
                                            +
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-4">
                                <div class="flex justify-between items-center">
                                    <label class="text-3xl font-normal text-gray-700">Phòng</label>
                                    <div class="flex items-center rounded-lg overflow-hidden border border-gray-300 w-fit">
                                        <button onclick="updateGuests('rooms', -1)"
                                                class="w-14 h-14 text-2xl bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none">
                                            -
                                        </button>
                                        <input type="number" id="roomsCount"
                                               class="w-20 h-14 text-center text-2xl bg-white text-gray-700 font-normal border-none focus:ring-0 no-spinner"
                                               value="1" min="1" oninput="updateGuests('rooms', 0)">
                                        <button onclick="updateGuests('rooms', 1)"
                                                class="w-14 h-14 text-2xl bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none">
                                            +
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <button onclick="closeGuestsDropdown()" class="w-full bg-cyan-600 text-white rounded-lg py-2 text-2xl font-medium hover:bg-cyan-700">DONE</button>
                        </div>
                    </div>
                </div>
                <div class="flex items-end h-full">
                    <a asp-controller="Find_Room" asp-action="Index"
                       class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 text-white rounded-lg px-3 pr-10 py-5 text-2xl font-medium hover:bg-cyan-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-cyan-500 transition duration-200 flex justify-center items-center">
                        <i class="fas fa-search mr-2"></i> Tìm kiếm
                    </a>

                </div>

            </div>
        </div>

        <link rel="stylesheet" href="@Url.Content("~/css/PageCSS/SearchSection.css")" />
        <script src="@Url.Content("~/js/PageJS/SearchSection.js")"></script>

        <section class="py-20 bg-gray-100" alt="phần hình ảnh">
            <div class="mx-auto max-w-full w-[1200px] px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-16">
                    <h2 class="text-4xl md:text-4xl font-bold text-gray-800 mb-4">ĐỊA ĐIỂM NỔI BẬT</h2>
                    <div class="w-24 h-1 bg-blue-600 mx-auto mb-6" alt="đường phân cách"></div>
                    <p class="text-gray-600 max-w-3xl mx-auto text-3xl">Khám phá những không gian tuyệt đẹp làm nên tên tuổi của khách sạn</p>
                </div>

                <div class="relative overflow-hidden">
                    <!-- Container cho carousel -->
                    <div id="carousel" class="flex transition-transform duration-500 ease-in-out" style="width: 1200px;">
                        @if (Model.BannerImages != null && Model.BannerImages.Any())
                        {
                            var total = Model.BannerImages.Count();
                            var index = 0;
                            foreach (var image in Model.BannerImages)
                            {
                                string marginClass;
                                if (index == 0)
                                {
                                    marginClass = "mr-2"; // Ảnh đầu tiên sát trái
                                }
                                else if (index == total - 1)
                                {
                                    marginClass = "ml-2"; // Ảnh cuối cùng sát phải
                                }
                                else
                                {
                                    marginClass = "mx-2";
                                }
                                <a href="@Url.Action("Details", "Location", new { id = index + 1 })"
                                   class="relative h-64 w-[288px] flex-shrink-0 overflow-hidden rounded-lg block @marginClass"
                                   alt="@image.Title">
                                    <img src="@image.ImageUrl" alt="@image.Title"
                                         class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 hover:scale-110">
                                    <div class="absolute inset-0 bg-black bg-opacity-30 flex items-center justify-center opacity-0 hover:opacity-100 transition-opacity duration-300">
                                        <span class="text-white font-medium text-3xl">@image.Title</span>
                                    </div>
                                </a>
                                index++;
                            }
                        }
                        else
                        {
                            <p>Không có hình ảnh để hiển thị.</p>
                        }
                    </div>

                    <!-- Nút mũi tên trái -->
                    <button id="prevBtn"
                            class="absolute left-0 top-0 bottom-0 w-16 bg-gray-800 bg-opacity-50 text-white flex items-center justify-center hover:bg-opacity-75 focus:outline-none hidden">
                        <i class="fas fa-chevron-left text-3xl"></i>
                    </button>

                    <!-- Nút mũi tên phải -->
                    <button id="nextBtn"
                            class="absolute right-0 top-0 bottom-0 w-16 bg-gray-800 bg-opacity-50 text-white flex items-center justify-center hover:bg-opacity-75 focus:outline-none hidden">
                        <i class="fas fa-chevron-right text-3xl"></i>
                    </button>
                </div>
            </div>
        </section>


        <!-- JavaScript để xử lý carousel -->
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const carousel = document.getElementById('carousel');
                const prevBtn = document.getElementById('prevBtn');
                const nextBtn = document.getElementById('nextBtn');
                const items = carousel.getElementsByTagName('a');
                const itemWidth = 288 + 8; // Chiều rộng mỗi mục (w-[288px] + mx-2 = 296px)
                const visibleItems = 4; // Số mục hiển thị cùng lúc
                let currentPosition = 0;

                // Kiểm tra và cập nhật giao diện
                function updateCarousel() {
                    const totalItems = items.length;
                    if (totalItems > visibleItems) {
                        prevBtn.classList.remove('hidden');
                        nextBtn.classList.remove('hidden');
                        carousel.style.transform = `translateX(-${currentPosition * itemWidth}px)`;

                        // Kích hoạt cuộn
                        prevBtn.disabled = currentPosition <= 0;
                        nextBtn.disabled = currentPosition >= totalItems - visibleItems;
                        prevBtn.classList.toggle('opacity-50', currentPosition <= 0);
                        nextBtn.classList.toggle('opacity-50', currentPosition >= totalItems - visibleItems);
                    } else {
                        prevBtn.classList.add('hidden');
                        nextBtn.classList.add('hidden');
                        carousel.style.transform = 'translateX(0)';
                    }
                }

                // Xử lý nút Previous
                prevBtn.addEventListener('click', () => {
                    if (currentPosition > 0) {
                        currentPosition--;
                        updateCarousel();
                    }
                });

                // Xử lý nút Next
                nextBtn.addEventListener('click', () => {
                    const totalItems = items.length;
                    if (currentPosition < totalItems - visibleItems) {
                        currentPosition++;
                        updateCarousel();
                    }
                });

                // Khởi tạo trạng thái ban đầu
                updateCarousel();

                // Theo dõi thay đổi dữ liệu (nếu admin thêm mục mới qua AJAX)
                window.addEventListener('bannerImagesUpdated', () => {
                    updateCarousel();
                });
            });
        </script>

        <!-- Font Awesome để sử dụng icon mũi tên -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />



        <section class="py-20 bg-white" alt="Nơi Tịnh Luyện Hoàn Hảo">
            <div class="mx-auto max-w-full w-[1200px] px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-16">
                    <h2 class="text-4xl md:text-4xl font-bold text-gray-800 mb-4">Nơi Tịnh Luyện Hoàn Hảo</h2>
                    <div class="w-24 h-1 bg-blue-600 mx-auto mb-6" alt="đường phân cách"></div>
                    <p class="text-gray-600 max-w-3xl mx-auto text-3xl">VietNamBooking định nghĩa lại sự sang trọng trong ngành khách sạn với sự chú ý tỉ mỉ đến chi tiết, dịch vụ xuất sắc và tầm nhìn tuyệt đẹp hướng ra sông Hương.</p>
                </div>
                <div class="grid md:grid-cols-3 gap-10">
                    @if (Model.Services != null && Model.Services.Any())
                    {
                        @foreach (var service in Model.Services)
                        {
                            <div class="text-center px-6">
                                <div class="w-20 h-20 bg-blue-50 rounded-full flex items-center justify-center mx-auto mb-6" alt="hình nền">
                                    <i class="@service.Icon text-3xl text-blue-600"></i>
                                </div>
                                <h3 class="text-xl font-bold text-gray-800 mb-4">@service.Name</h3>
                                <p class="text-gray-600">@service.Description</p>
                            </div>
                        }
                    }
                    else
                    {
                        <p>Không có dịch vụ để hiển thị.</p>
                    }
                </div>
            </div>
        </section>

        <section class="mx-auto max-w-full w-[1200px] px-4 sm:px-6 lg:px-8 py-16">
            <div class="text-center mb-12">
                <h2 class="text-4xl font-bold text-gray-800 mb-4">Tùy Chọn Lưu Trú</h2>
                <p class="text-gray-600 max-w-2xl mx-auto text-3xl">Chọn từ danh sách các phòng và suite được trang bị sang trọng của chúng tôi</p>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                @if (Model.Rooms != null && Model.Rooms.Any())
                {
                    @foreach (var room in Model.Rooms)
                    {
                        <div class="bg-white rounded-lg shadow-md overflow-hidden" alt="@room.Name">
                            <img src="@room.ImageUrl" alt="@room.Name" class="w-full h-64 object-cover" loading="lazy">
                            <div class="p-6">
                                <h3 class="text-2xl font-bold text-gray-800 mb-2">@room.Name</h3>
                                <p class="text-gray-600 mb-4 text-2xl">@room.Description</p>
                                <div class="flex justify-between items-center">
                                    <span class="text-blue-600 font-bold text-3xl">Từ @room.Price VNĐ/đêm</span>
                                    <a href="#" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition" alt="Xem Chi Tiết">Xem Chi Tiết</a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p>Không có phòng để hiển thị.</p>
                }
            </div>
        </section>

        <section class="bg-gray-100 py-16" alt="Tiện Ích Phòng">
            <div class="mx-auto max-w-full w-[1200px] px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2 class="text-3xl font-bold text-gray-800 mb-4">Tiện Ích Phòng</h2>
                    <p class="text-gray-600 max-w-2xl mx-auto">Tất cả phòng của chúng tôi đều được trang bị tiện nghi cao cấp cho sự thoải mái của bạn</p>
                </div>
                <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
                    @if (Model.Amenities != null && Model.Amenities.Any())
                    {
                        @foreach (var amenity in Model.Amenities)
                        {
                            <div class="bg-white p-6 rounded-lg shadow-sm text-center" alt="@amenity.Name">
                                <i class="@amenity.Icon text-4xl text-blue-500 mb-4"></i>
                                <h3 class="text-lg font-semibold text-gray-800 mb-2">@amenity.Name</h3>
                                <p class="text-gray-600">@amenity.Description</p>
                            </div>
                        }
                    }
                    else
                    {
                        <p>Không có tiện ích để hiển thị.</p>
                    }
                </div>
            </div>
        </section>

        <section class="mx-auto max-w-full w-[1200px] px-4 sm:px-6 lg:px-8 py-16">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
                <div class="relative">
                    <img src="https://images.unsplash.com/photo-1573052905904-34ad8c27f0cc?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80"
                         alt="nội thất khách sạn"
                         class="rounded-lg shadow-lg w-full h-full object-cover aspect-[4/3]"
                         loading="lazy">
                </div>
                <div>
                    <h2 class="text-3xl font-bold text-gray-800 mb-6">Ưu Đãi Đặc Biệt</h2>
                    <p class="text-gray-600 mb-6">Tận hưởng các gói ưu đãi độc quyền và chương trình khuyến mãi để nâng cao trải nghiệm lưu trú của bạn.</p>
                    @if (Model.Offers != null && Model.Offers.Any())
                    {
                        @foreach (var offer in Model.Offers)
                        {
                            <div class="bg-blue-50 p-6 rounded-lg mb-6" alt="@offer.Title">
                                <h3 class="text-xl font-semibold text-gray-800 mb-2">@offer.Title</h3>
                                <p class="text-gray-600 mb-4">@offer.Description</p>
                                <a href="#" class="text-blue-600 font-medium hover:underline">Tìm Hiểu Thêm</a>
                            </div>
                        }
                    }
                    else
                    {
                        <p>Không có ưu đãi để hiển thị.</p>
                    }
                </div>
            </div>
        </section>

        <section class="py-20 bg-white" alt="Hội Viên Độc Quyền">
            <div class="mx-auto max-w-full w-[1200px] px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
                    <div>
                        <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-6">Hội Viên Độc Quyền</h2>
                        <div class="w-24 h-1 bg-blue-600 mb-6" alt="đường phân cách"></div>
                        <p class="text-gray-600 mb-8">Tham gia Vòng Tròn Ưu Đãi của chúng tôi để tận hưởng các lợi ích độc quyền, dịch vụ cá nhân hóa và truy cập vào các sự kiện dành riêng cho hội viên.</p>
                        @if (Model.MembershipBenefits != null && Model.MembershipBenefits.Any())
                        {
                            <ul class="space-y-4 mb-8">
                                @foreach (var benefit in Model.MembershipBenefits)
                                {
                                    <li class="flex items-start">
                                        <i class="fas fa-check-circle text-blue-600 mt-1 mr-3"></i>
                                        <span class="text-gray-800">@benefit.Benefit</span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>Không có lợi ích hội viên để hiển thị.</p>
                        }
                        <a href="#" class="px-8 py-3 bg-blue-600 text-white font-medium rounded hover:bg-blue-700 transition duration-300 inline-block" alt="tham gia ngay">Tham Gia Ngay</a>
                    </div>
